                      display:inline-block; margin-right:.4rem; }
    @@keyframes im-spin { to { transform:rotate(360deg); } }
</style>

@code {
    [Parameter][SupplyParameterFromQuery] public string? PacienteId { get; set; }

    private Guid TenantId;
    private Guid UsuarioId;

    // ── Búsqueda de paciente ──────────────────────────────────────────────────
    private string  _busqueda          = string.Empty;
    private bool    _buscando          = false;
    private bool    _busquedaRealizada = false;
    private List<Paciente> _resultadosBusqueda = new();
    private Paciente? _pacienteSeleccionado;
    private System.Threading.CancellationTokenSource? _debounce;

    // ── Período ───────────────────────────────────────────────────────────────
    private int _mes  = DateTime.Today.Month;
    private int _anio = DateTime.Today.Year;

    // ── Formulario ────────────────────────────────────────────────────────────
    private EntradaManualDto _form = new();
    private bool   _guardando      = false;
    private string _error          = string.Empty;
    private ResultadoEntradaManualDto? _resultado;
    private SnapshotMensual?           _snapshotExistente;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        TenantId  = Guid.TryParse(auth.User.FindFirst("tenant_id")?.Value, out var t) ? t : Guid.Empty;
        UsuarioId = Guid.TryParse(auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var u) ? u : Guid.Empty;

        if (!string.IsNullOrEmpty(PacienteId) && Guid.TryParse(PacienteId, out var pid))
        {
            var p = await PacienteRepo.GetByIdAsync(TenantId, pid);
            if (p != null) SeleccionarPaciente(p);
        }
    }

    // ── Búsqueda ──────────────────────────────────────────────────────────────

    private async Task BuscarPacientesAsync()
    {
        _debounce?.Cancel(); _debounce?.Dispose();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (string.IsNullOrWhiteSpace(_busqueda)) { _resultadosBusqueda.Clear(); return; }
            _buscando = true; StateHasChanged();
            _resultadosBusqueda = await PacienteRepo.GetActivosAsync(TenantId, _busqueda);
            _busquedaRealizada  = true;
        }
        catch (TaskCanceledException) { }
        finally { _buscando = false; }
    }

    private void SeleccionarPaciente(Paciente p)
    {
        _pacienteSeleccionado = p;
        _resultadosBusqueda.Clear();
        _busqueda = string.Empty;
        _snapshotExistente = null;
    }

    private void LimpiarPaciente()
    {
        _pacienteSeleccionado = null;
        _snapshotExistente    = null;
        _busquedaRealizada    = false;
        LimpiarFormulario();
    }

    // ── Carga de snapshot existente ───────────────────────────────────────────

    private async Task CargarSnapshotExistenteAsync()
    {
        if (_pacienteSeleccionado == null) return;
        _snapshotExistente = await EntradaManual.GetSnapshotAsync(
            TenantId, _pacienteSeleccionado.Id, _anio, _mes);

        if (_snapshotExistente != null)
        {
            _form.HbValor        = _snapshotExistente.HbValor;
            _form.HierroValor    = _snapshotExistente.HierroValor;
            _form.FerritinaValor = _snapshotExistente.FerritinaValor;
            _form.SaturacionValor = _snapshotExistente.SaturacionValor;
        }
    }

    // ── Guardar ───────────────────────────────────────────────────────────────

    private async Task GuardarAsync()
    {
        _error = string.Empty;
        if (_pacienteSeleccionado == null) { _error = "Seleccione un paciente."; return; }
        if (!_form.TieneAlgunValor)        { _error = "Ingrese al menos un resultado."; return; }

        _guardando = true;
        try
        {
            _form.PacienteId  = _pacienteSeleccionado.Id;
            _form.PeriodoAnio = _anio;
            _form.PeriodoMes  = _mes;
            _resultado = await EntradaManual.ProcesarAsync(_form, TenantId, UsuarioId);
            if (_resultado.Exitoso) LimpiarFormulario();
        }
        finally { _guardando = false; }
    }

    private void LimpiarFormulario()
    {
        _form = new EntradaManualDto();
        _error = string.Empty;
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static string NombreMes(int m) => m switch
    {
        1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril",
        5 => "Mayo",  6 => "Junio",   7 => "Julio", 8 => "Agosto",
        9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre",
        _ => m.ToString()
    };

    private static string FormatVal(decimal? val, string? unidad) =>
        val.HasValue ? $"{val:G} {unidad}".Trim() : "—";
}
