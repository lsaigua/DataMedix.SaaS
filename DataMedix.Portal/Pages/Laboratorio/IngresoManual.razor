    .im-title     { font-size:1.75rem; font-weight:700; color:#1e293b; margin:0; }
    .im-subtitle  { color:#64748b; margin:.25rem 0 0; font-size:.9rem; }
    .im-layout    { display:grid; grid-template-columns:320px 1fr; gap:1.25rem; align-items:start; }
    @@media(max-width:768px) { .im-layout { grid-template-columns:1fr; } }

    /* ─── Cards ───────────────────────────────────────────────────────────────── */
    .im-card        { background:white; border-radius:12px; box-shadow:0 1px 3px rgba(0,0,0,.08); padding:1.25rem; margin-bottom:1rem; }
    .im-card-info   { background:#eff6ff; border:1.5px solid #bfdbfe; }
    .im-card-title  { font-size:.75rem; font-weight:800; text-transform:uppercase; letter-spacing:.05em;
                      color:#94a3b8; margin-bottom:.875rem; }

    /* ─── Búsqueda ────────────────────────────────────────────────────────────── */
    .im-search-wrap   { margin-bottom:.75rem; }
