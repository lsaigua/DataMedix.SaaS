                          border:1.5px solid #e2e8f0; border-radius:8px; }
    .im-search-item   { background:none; border:none; text-align:left; padding:.625rem .875rem; cursor:pointer;
                         border-bottom:1px solid #f1f5f9; transition:background .15s; }
    .im-search-item:last-child { border-bottom:none; }
    .im-search-item:hover { background:#f8fafc; }
