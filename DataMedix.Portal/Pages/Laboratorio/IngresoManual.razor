    /* ─── Toast ───────────────────────────────────────────────────────────────── */
    .im-toast       { display:flex; align-items:center; gap:.75rem; flex-wrap:wrap; padding:.75rem 1rem;
                      border-radius:8px; margin-bottom:1rem; font-size:.875rem; font-weight:500; }
    .im-toast button { margin-left:auto; background:none; border:none; cursor:pointer; font-size:1rem; opacity:.7; }
    .im-toast-ok    { background:#d1fae5; color:#065f46; }
    .im-toast-err   { background:#fee2e2; color:#991b1b; }
    .im-toast-warn  { color:#92400e; }

    /* ─── Inputs comunes ─────────────────────────────────────────────────────── */
