@page "/laboratorio/manual"
@attribute [Authorize]
@using Microsoft.AspNetCore.Authorization
@using DataMedix.Application.DTOs.EntradaManual
@using DataMedix.Application.Interfaces
@using DataMedix.Domain.Entities
@using System.Security.Claims

@inject IEntradaManualService EntradaManual
@inject IPacienteRepository PacienteRepo
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Ingreso Manual de Resultados | DataMedix</PageTitle>

<div class="im-header">
    <div>
        <h1 class="im-title">Ingreso Manual de Resultados</h1>
        <p class="im-subtitle">Para pacientes que no envían resultados por Excel</p>
    </div>
    <a href="/pacientes" class="im-btn im-btn-ghost">← Volver a Pacientes</a>
</div>

<!-- Toasts -->
@if (_resultado != null)
{
    <div class="im-toast @(_resultado.Exitoso ? "im-toast-ok" : "im-toast-err")">
        @if (_resultado.Exitoso)
        {
            <strong>✓ Resultados guardados</strong>
            <span>— @PacienteDisplay.Mask(_resultado.NombrePaciente) · @NombreMes(_resultado.PeriodoMes) @_resultado.PeriodoAnio</span>
            @if (_resultado.PrescripcionBloqueada)
            {
                <span class="im-toast-warn"> · La prescripción ya fue aprobada; no se regeneró.</span>
            }
        }
        else
        {
            <strong>⚠ Error:</strong>
            <span>@_resultado.MensajeError</span>
        }
        <button @onclick="() => _resultado = null">✕</button>
    </div>
}

<div class="im-layout">
    <!-- ══ PANEL IZQUIERDO: selección paciente + período ══ -->
    <div class="im-sidebar">
        <div class="im-card">
            <div class="im-card-title">1. Seleccionar Paciente</div>

            @if (_pacienteSeleccionado == null)
            {
                <div class="im-search-wrap">
                    <input type="text" class="im-input" placeholder="Buscar por nombre o cédula..."
                           @bind="_busqueda" @bind:event="oninput"
                           @onkeyup="BuscarPacientesAsync" />
                </div>

                @if (_buscando)
                {
                    <div class="im-loading-sm"><div class="im-spinner-sm"></div> Buscando...</div>
                }
                else if (_resultadosBusqueda.Any())
                {
                    <div class="im-search-results">
                        @foreach (var p in _resultadosBusqueda)
                        {
                            <button class="im-search-item" @onclick="() => SeleccionarPaciente(p)">
                                <div class="im-si-nombre">@PacienteDisplay.Mask(p.NombreCompleto)</div>
                                <div class="im-si-ident">@p.Identificacion</div>
                            </button>
                        }
                    </div>
                }
                else if (_busquedaRealizada && !_buscando)
                {
                    <p class="im-no-results">Sin resultados. Puede <a href="/pacientes">crear el paciente</a> primero.</p>
                }
            }
            else
            {
                <div class="im-paciente-sel">
                    <div class="im-ps-avatar">@_pacienteSeleccionado.PrimerNombre[0]</div>
                    <div class="im-ps-info">
                        <div class="im-ps-nombre">@PacienteDisplay.Mask(_pacienteSeleccionado.NombreCompleto)</div>
                        <div class="im-ps-ident">@_pacienteSeleccionado.Identificacion</div>
                        @if (!string.IsNullOrEmpty(_pacienteSeleccionado.PlanSalud))
                        {
                            <div class="im-ps-plan">@_pacienteSeleccionado.PlanSalud</div>
                        }
                    </div>
                    <button class="im-ps-change" title="Cambiar paciente" @onclick="LimpiarPaciente">✕</button>
                </div>
            }
        </div>

        <div class="im-card">
            <div class="im-card-title">2. Período</div>
            <div class="im-periodo-grid">
                <div class="im-form-group">
                    <label>Mes</label>
                    <select class="im-input" @bind="_mes">
                        @for (int m = 1; m <= 12; m++)
                        {
                            <option value="@m">@NombreMes(m)</option>
                        }
                    </select>
                </div>
                <div class="im-form-group">
                    <label>Año</label>
                    <select class="im-input" @bind="_anio">
                        @for (int a = DateTime.Today.Year; a >= DateTime.Today.Year - 3; a--)
                        {
                            <option value="@a">@a</option>
                        }
                    </select>
                </div>
            </div>
            @if (_pacienteSeleccionado != null)
            {
                <button class="im-btn-cargar-existente im-btn im-btn-outline"
                        @onclick="CargarSnapshotExistenteAsync">
                    🔍 Cargar datos existentes
                </button>
            }
        </div>

        @if (_snapshotExistente != null)
        {
            <div class="im-card im-card-info">
                <div class="im-card-title">Datos previos (@NombreMes(_mes) @_anio)</div>
                <div class="im-prev-item">Hb: <strong>@FormatVal(_snapshotExistente.HbValor, _snapshotExistente.HbUnidad)</strong></div>
                <div class="im-prev-item">Hierro: <strong>@FormatVal(_snapshotExistente.HierroValor, _snapshotExistente.HierroUnidad)</strong></div>
                <div class="im-prev-item">Ferritina: <strong>@FormatVal(_snapshotExistente.FerritinaValor, _snapshotExistente.FerritinaUnidad)</strong></div>
                <div class="im-prev-item">TSAT: <strong>@FormatVal(_snapshotExistente.SaturacionValor, _snapshotExistente.SaturacionUnidad)</strong></div>
                @if (_snapshotExistente.EsDatosPeriodoAnterior)
                {
                    <p class="im-prev-note">ℹ Panel de hierro copiado de período anterior.</p>
                }
            </div>
        }
    </div>

    <!-- ══ PANEL DERECHO: formulario de resultados ══ -->
    <div class="im-main">
        <div class="im-card">
            <div class="im-card-title">3. Resultados de Laboratorio</div>

            @if (_pacienteSeleccionado == null)
            {
                <div class="im-placeholder">
                    <span>👈</span>
                    <p>Primero seleccione un paciente</p>
                </div>
            }
            else
            {
                <!-- Panel principal -->
                <div class="im-section-label">Panel Principal (EPO)</div>
                <div class="im-campos-grid">
                    <div class="im-field">
                        <label>Hemoglobina (Hb)</label>
                        <div class="im-input-unit">
                            <input type="number" step="0.1" min="0" max="25" class="im-input"
                                   placeholder="ej: 10.5" @bind="_form.HbValor" />
                            <span class="im-unit">g/dL</span>
                        </div>
                        <div class="im-field-hint">Rango normal: 10–12 g/dL (HD)</div>
                    </div>
                    <div class="im-field">
                        <label>Hierro Sérico</label>
                        <div class="im-input-unit">
                            <input type="number" step="1" min="0" max="500" class="im-input"
                                   placeholder="ej: 65" @bind="_form.HierroValor" />
                            <span class="im-unit">µg/dL</span>
                        </div>
                        <div class="im-field-hint">Normal: 60–170 µg/dL</div>
                    </div>
                    <div class="im-field">
                        <label>Ferritina</label>
                        <div class="im-input-unit">
                            <input type="number" step="1" min="0" max="10000" class="im-input"
                                   placeholder="ej: 250" @bind="_form.FerritinaValor" />
                            <span class="im-unit">ng/mL</span>
                        </div>
                        <div class="im-field-hint">Objetivo: 200–500 ng/mL</div>
                    </div>
                    <div class="im-field">
                        <label>Saturación de Transferrina (TSAT)</label>
                        <div class="im-input-unit">
                            <input type="number" step="0.1" min="0" max="100" class="im-input"
                                   placeholder="ej: 25" @bind="_form.SaturacionValor" />
                            <span class="im-unit">%</span>
                        </div>
                        <div class="im-field-hint">Objetivo: 20–40%</div>
                    </div>
                </div>

                <!-- Parámetros adicionales -->
                <details class="im-extras">
                    <summary class="im-extras-toggle">
                        Parámetros adicionales (Potasio, Albúmina, Peso)
                        <span class="im-extras-badge">opcional</span>
                    </summary>
                    <div class="im-campos-grid" style="margin-top:.875rem">
                        <div class="im-field">
                            <label>Potasio</label>
                            <div class="im-input-unit">
                                <input type="number" step="0.1" min="0" max="20" class="im-input"
                                       placeholder="ej: 5.2" @bind="_form.PotasioValor" />
                                <span class="im-unit">mEq/L</span>
                            </div>
                            <div class="im-field-hint">Normal: 3.5–5.5 mEq/L</div>
                        </div>
                        <div class="im-field">
                            <label>Albúmina</label>
                            <div class="im-input-unit">
                                <input type="number" step="0.1" min="0" max="10" class="im-input"
                                       placeholder="ej: 3.8" @bind="_form.AlbuminaValor" />
                                <span class="im-unit">g/dL</span>
                            </div>
                            <div class="im-field-hint">Normal: 3.5–5.0 g/dL</div>
                        </div>
                        <div class="im-field">
                            <label>Peso</label>
                            <div class="im-input-unit">
                                <input type="number" step="0.1" min="0" max="300" class="im-input"
                                       placeholder="ej: 70" @bind="_form.PesoKgValor" />
                                <span class="im-unit">kg</span>
                            </div>
                        </div>
                    </div>
                </details>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="im-alert-err">⚠ @_error</div>
                }

                <div class="im-actions">
                    <button class="im-btn im-btn-ghost" @onclick="LimpiarFormulario">
                        Limpiar campos
                    </button>
                    <button class="im-btn im-btn-primary" @onclick="GuardarAsync" disabled="@_guardando">
                        @if (_guardando) { <span class="im-spinner-sm"></span> }
                        Guardar y Generar Prescripción
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
