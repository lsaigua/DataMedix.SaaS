@page "/laboratorio/historial"
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Authorization
@using DataMedix.Application.Interfaces
@using DataMedix.Application.DTOs
@using DataMedix.Domain.Entities
@using System.Security.Claims

@inject IResultadoLaboratorioRepository ResultadoRepo
@inject IParametroClinicoRepository ParametroRepo
@inject ILoteImportacionRepository LoteRepo
@inject AuthenticationStateProvider AuthState
@inject NavigationManager Nav

<PageTitle>Resultados Crudos | DataMedix</PageTitle>

<!-- ═══ HEADER ═══════════════════════════════════════════════════════════════ -->
<div class="hr-header">
    <div>
        <h1 class="hr-title">Resultados Crudos</h1>
        <p class="hr-subtitle">
            @if (_vista == "pivot")
            {
                <span>
                    Matriz de resultados &middot;
                    @NombreMes(_pivotMes) @_pivotAnio &middot;
                    Fecha orden: <strong>@(new DateTime(_pivotAnio, _pivotMes, 1).ToString("d/MM/yyyy"))</strong>
                </span>
            }
            else { <span>Listado por resultado &middot; @Total registro(s)</span> }
        </p>
    </div>
    <div class="hr-header-actions">
        <div class="hr-vista-toggle">
            <button class="hr-vista-btn @(_vista == "pivot" ? "hr-vista-active" : "")" @onclick="() => SetVista('p')">&#8862; Pivot</button>
            <button class="hr-vista-btn @(_vista == "lista" ? "hr-vista-active" : "")" @onclick="() => SetVista('l')">&#9776; Lista</button>
        </div>
        <button class="hr-btn hr-btn-outline" @onclick="RefrescarAsync" disabled="@Cargando" title="Actualizar">&#8635;</button>
        <button class="hr-btn hr-btn-excel" @onclick="ExportarExcel"
                disabled="@(Cargando || (_vista == "lista" && Total == 0) || (_vista == "pivot" && !_filasPivot.Any()))">
            &#128229; Excel
        </button>
    </div>
</div>

@if (ErrorMensaje != null)
{
    <div class="hr-error-banner">&#9888; @ErrorMensaje <button @onclick="() => ErrorMensaje = null">&#10005;</button></div>
}

<!-- ═══ VISTA PIVOT ════════════════════════════════════════════════════════════ -->
@if (_vista == "pivot")
{
    <!-- ── PANEL DE FILTROS ── -->
    <div class="hr-card hr-fpanel">

        <!-- BLOQUE 1: Período — año + 12 meses en una sola línea -->
        <div class="hr-fp-bloque hr-fp-periodo">
            <span class="hr-fp-etiqueta">PERÍODO</span>
            <div class="hr-fp-periodo-inner">
                <select class="hr-year-sel" @bind="_pivotAnio" @bind:after="CargarPivotAsync">
                    @for (int a = DateTime.Now.Year; a >= DateTime.Now.Year - 3; a--)
                    { var an = a; <option value="@an">@an</option> }
                </select>
                <div class="hr-months-grid">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var mes = m;
                        <button class="hr-month-btn @(_pivotMes == mes ? "hr-month-on" : "")"
                                @onclick="async () => { _pivotMes = mes; await CargarPivotAsync(); }">
                            @NombreMes3(mes)
                        </button>
                    }
                </div>
            </div>
        </div>

        <!-- BLOQUE 2: Tipo de atención + Búsqueda + Contador -->
        <div class="hr-fp-bloque hr-fp-controles">
            <!-- Tipo de atención -->
            <div class="hr-fp-grupo">
                <span class="hr-fp-etiqueta">TIPO DE ATENCIÓN</span>
                <div class="hr-tipo-btns">
                    <button class="hr-tbtn @(!_filtrosTipo.Any() ? "hr-tbtn-on" : "")"
                            @onclick="() => { _filtrosTipo.Clear(); FiltrarPivot(); }">Todos</button>
                    @foreach (var t in _tiposAtencion)
                    {
                        var tipo = t;
                        <button class="hr-tbtn @(_filtrosTipo.Contains(tipo) ? "hr-tbtn-on" : _filtrosTipo.Any() ? "hr-tbtn-off" : "")"
                                @onclick="() => ToggleTipo(tipo)">@tipo</button>
                    }
                    @if (!_tiposAtencion.Any() && !Cargando)
                    { <span class="hr-fp-hint">Sin datos en este período</span> }
                </div>
            </div>

            <div class="hr-fp-divisor-v"></div>

            <!-- Búsqueda -->
            <div class="hr-fp-grupo hr-fp-search-grupo">
                <span class="hr-fp-etiqueta">BUSCAR PACIENTE</span>
                <div class="hr-sbox">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                    <input class="hr-sbox-input" type="text" placeholder="Nombre o cédula…"
                           @bind="_filtroNombrePivot" @bind:event="oninput"
                           @onkeyup="OnBusquedaPivotChange" />
                    @if (!string.IsNullOrEmpty(_filtroNombrePivot))
                    {
                        <button class="hr-sbox-clear" @onclick="() => { _filtroNombrePivot = string.Empty; FiltrarPivot(); }">&#10005;</button>
                    }
                </div>
            </div>

            <!-- Contador -->
            <div class="hr-fp-stats">
                <div class="hr-stat-num">@_filasPivot.Count</div>
                <div class="hr-stat-lbl">pac.</div>
                <div class="hr-stat-dot">·</div>
                <div class="hr-stat-num">@_columnasVisibles.Count</div>
                <div class="hr-stat-lbl">param.</div>
            </div>
        </div>

        <!-- BLOQUE 3: Filtro de columnas / parámetros -->
        <div class="hr-fp-bloque hr-fp-params-bar">
            <button class="hr-colfilter-btn @(_mostrarFiltroParam ? "hr-colfilter-open" : "")"
                    @onclick="() => _mostrarFiltroParam = !_mostrarFiltroParam">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/></svg>
                @if (_filtrosParametroKeys.Any())
                { <span><strong>@_filtrosParametroKeys.Count</strong> parámetro(s) seleccionado(s)</span> }
                else
                { <span>Filtrar columnas (todas visibles)</span> }
                <span class="hr-colfilter-arrow">@(_mostrarFiltroParam ? "▲" : "▼")</span>
            </button>
            @if (_filtrosParametroKeys.Any())
            {
                <button class="hr-btn hr-btn-xs hr-btn-outline"
                        @onclick="() => { _filtrosParametroKeys.Clear(); ActualizarColumnasVisibles(); StateHasChanged(); }">
                    &#10005; Mostrar todas
                </button>
            }
        </div>

        @if (_mostrarFiltroParam && _columnasPivot.Any())
        {
            <div class="hr-cols-grid">
                @foreach (var col in _columnasPivot)
                {
                    var key = col.Key;
                    var esSel = _filtrosParametroKeys.Contains(key);
                    var esActiva = !_filtrosParametroKeys.Any() || esSel;
                    <button class="hr-col-chip @(esActiva ? "hr-col-on" : "hr-col-off")"
                            title="@col.Nombre"
                            @onclick="() => ToggleParametro(key)">@col.Nombre</button>
                }
            </div>
        }

    </div><!-- /hr-fpanel -->

    <!-- ── TABLA PIVOT ── -->
    @if (Cargando)
    {
        <div class="hr-loading">
            <div class="hr-spinner"></div>
            <p>Cargando @NombreMes(_pivotMes) @_pivotAnio&hellip;</p>
        </div>
    }
    else if (!_rawResultados.Any())
    {
        <div class="hr-empty">
            <div class="hr-empty-icon">&#128300;</div>
            <h3>Sin resultados para @NombreMes(_pivotMes) @_pivotAnio</h3>
            <p>Importa un archivo o ingresa resultados manualmente para este período.</p>
            <div style="display:flex;gap:.75rem;justify-content:center;flex-wrap:wrap">
                <a href="/laboratorio/importar" class="hr-btn hr-btn-primary">&#128229; Importar Excel</a>
                <a href="/laboratorio/manual" class="hr-btn hr-btn-outline">&#9998; Ingreso Manual</a>
            </div>
        </div>
    }
    else if (!_filasPivot.Any())
    {
        <div class="hr-empty">
            <div class="hr-empty-icon">&#128269;</div>
            <h3>Sin coincidencias</h3>
            <p>Ajusta los filtros para ver resultados.</p>
        </div>
    }
    else
    {
        <div class="hr-card hr-pivot-card">
            <div class="hr-pivot-scroll">
                <table class="hr-pivot-table">
                    <thead>
                        <tr>
                            <th class="hr-th-fixed hr-th-tipo">Tipo At.</th>
                            <th class="hr-th-fixed hr-th-cedula">Cédula</th>
                            <th class="hr-th-fixed hr-th-paciente">Paciente</th>
                            @foreach (var col in _columnasVisibles)
                            {
                                <th class="hr-th-param" title="@col.Nombre (@col.Codigo)">@col.NombreCorto</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in PaginaPivot)
                        {
                            <tr class="@(fila.TienePatologico ? "hr-row-pato" : "")">
                                <td class="hr-td-fixed hr-td-tipo">
                                    <span class="hr-badge-tipo">@(fila.TipoAtencion ?? "—")</span>
                                </td>
                                <td class="hr-td-fixed hr-td-cedula">
                                    <code class="hr-ident">@fila.Identificacion</code>
                                </td>
                                <td class="hr-td-fixed hr-td-nombre">@PacienteDisplay.Mask(fila.Nombre)</td>
                                @foreach (var col in _columnasVisibles)
                                {
                                    @if (fila.Celdas.TryGetValue(col.Key, out var celda))
                                    {
                                        <td class="@(celda.EsPatologico ? "hr-cell-pato" : "hr-cell-ok")"
                                            title="@TituloCelda(celda)">
                                            @(celda.Valor?.ToString("G5") ?? celda.Texto ?? "—")
                                        </td>
                                    }
                                    else
                                    {
                                        <td class="hr-cell-empty">—</td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (TotalPaginasPivot > 1)
            {
                <div class="hr-pagination">
                    <button class="hr-btn hr-btn-sm hr-btn-outline"
                            @onclick="PivotAnterior" disabled="@(_pivotPagina <= 1)">&#8592;</button>
                    <span class="hr-pag-info">
                        @((_pivotPagina - 1) * PivotTamano + 1)–@Math.Min(_pivotPagina * PivotTamano, _filasPivot.Count)
                        de @_filasPivot.Count pacientes
                    </span>
                    <button class="hr-btn hr-btn-sm hr-btn-outline"
                            @onclick="PivotSiguiente" disabled="@(_pivotPagina >= TotalPaginasPivot)">&#8594;</button>
                </div>
            }
        </div>

        <p class="hr-carry-note">
            &#128161; Las celdas en rojo son valores patológicos. Las celdas (—) no fueron reportadas en este período.
            El sistema usa los valores del mes anterior para Hierro, Ferritina y TSAT al generar prescripciones.
        </p>
    }
}

<!-- ═══ VISTA LISTA ════════════════════════════════════════════════════════════ -->
@if (_vista == "lista")
{
    <div class="hr-card hr-filters-card">
        <div class="hr-list-filters">
            <div class="hr-filter-group">
                <label>Paciente</label>
                <div class="hr-search-wrap">
                    <input type="text" class="hr-input" placeholder="Nombre o cédula..."
                           @bind="BusquedaPaciente" @bind:event="oninput" @onkeyup="BuscarDebounced" />
                </div>
            </div>
            <div class="hr-filter-group">
                <label>Parámetro</label>
                <select class="hr-select" value="@(Filtro.ParametroClinicoId?.ToString() ?? "")"
                        @onchange="OnParametroChange">
                    <option value="">Todos</option>
                    @foreach (var p in Parametros)
                    { <option value="@p.Id">@p.Nombre (@p.Codigo)</option> }
                </select>
            </div>
            <div class="hr-filter-group">
                <label>Desde</label>
                <div class="hr-date-pair">
                    <select class="hr-select hr-select-mes" value="@(Filtro.MesDe?.ToString() ?? "")" @onchange="OnMesDesdeChange">
                        <option value="">Mes</option>
                        @for (int m = 1; m <= 12; m++) { var mes = m; <option value="@mes">@NombreMes(mes)[..3]</option> }
                    </select>
                    <select class="hr-select hr-select-anio" value="@(Filtro.AnioDe?.ToString() ?? "")" @onchange="OnAnioDesdeChange">
                        <option value="">Año</option>
                        @for (int a = DateTime.Now.Year; a >= DateTime.Now.Year - 3; a--) { var an = a; <option value="@an">@an</option> }
                    </select>
                </div>
            </div>
            <div class="hr-filter-group">
                <label>Hasta</label>
                <div class="hr-date-pair">
                    <select class="hr-select hr-select-mes" value="@(Filtro.MesHasta?.ToString() ?? "")" @onchange="OnMesHastaChange">
                        <option value="">Mes</option>
                        @for (int m = 1; m <= 12; m++) { var mes = m; <option value="@mes">@NombreMes(mes)[..3]</option> }
                    </select>
                    <select class="hr-select hr-select-anio" value="@(Filtro.AnioHasta?.ToString() ?? "")" @onchange="OnAnioHastaChange">
                        <option value="">Año</option>
                        @for (int a = DateTime.Now.Year; a >= DateTime.Now.Year - 3; a--) { var an = a; <option value="@an">@an</option> }
                    </select>
                </div>
            </div>
            <div class="hr-filter-group">
                <label>Lote</label>
                <select class="hr-select" value="@(Filtro.LoteId?.ToString() ?? "")" @onchange="OnLoteChange">
                    <option value="">Todos</option>
                    @foreach (var l in Lotes)
                    {
                        <option value="@l.Id">@(new DateTime(l.PeriodoAnio, l.PeriodoMes, 1).ToString("MMM yyyy")) — @Trunc(l.NombreArchivoOriginal, 22)</option>
                    }
                </select>
            </div>
            @if (Filtro.HayFiltrosActivos)
            {
                <div class="hr-filter-group" style="justify-content:flex-end">
                    <label>&nbsp;</label>
                    <button class="hr-btn hr-btn-sm hr-btn-outline" @onclick="LimpiarFiltros">&#10005; Limpiar</button>
                </div>
            }
        </div>
    </div>

    <div class="hr-meta-bar">
        @if (!Cargando)
        {
            <span><strong>@Total</strong> resultado(s) @if (Filtro.HayFiltrosActivos) { <span class="hr-tag">filtrado</span> }</span>
            @if (Total > 0) { <span class="hr-pag-info">Pág. @Filtro.Pagina / @TotalPaginasLista</span> }
        }
    </div>

    @if (Cargando)
    {
        <div class="hr-loading"><div class="hr-spinner"></div><p>Cargando...</p></div>
    }
    else if (!Resultados.Any())
    {
        <div class="hr-empty">
            <div class="hr-empty-icon">&#128300;</div>
            <h3>@(Filtro.HayFiltrosActivos ? "Sin resultados para este filtro" : "Sin resultados importados")</h3>
            <p>@(Filtro.HayFiltrosActivos ? "Ajusta los filtros." : "Importa un archivo para ver resultados aquí.")</p>
        </div>
    }
    else
    {
        <div class="hr-card">
            <div class="hr-table-wrap">
                <table class="hr-table">
                    <thead>
                        <tr>
                            <th>Identificación</th><th>Paciente</th><th>Parámetro</th>
                            <th class="hr-th-r">Valor</th><th>Unidad</th><th>Referencia</th>
                            <th class="hr-th-c">Patológico</th><th>Período</th><th>Lote</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Resultados)
                        {
                            <tr class="@(r.EsPatologico ? "hr-row-pato" : "")">
                                <td><code class="hr-ident">@r.Paciente.Identificacion</code></td>
                                <td><span class="hr-pac-nombre">@PacienteDisplay.Mask(r.Paciente.NombreCompleto)</span></td>
                                <td>
                                    <div class="hr-param-cell">
                                        <span class="hr-param-nombre">@(r.ParametroClinico?.Nombre ?? r.ParametroRaw ?? "—")</span>
                                        @if (r.ParametroClinico?.Codigo != null)
                                        { <span class="hr-param-cod">@r.ParametroClinico.Codigo</span> }
                                    </div>
                                </td>
                                <td class="hr-td-r">
                                    <span class="hr-valor @(r.EsPatologico ? "hr-valor-pato" : "")">
                                        @(r.ValorNumerico.HasValue ? r.ValorNumerico.Value.ToString("G6") : r.ResultadoTexto)
                                    </span>
                                </td>
                                <td class="hr-unidad">@(r.UnidadMedida ?? "—")</td>
                                <td class="hr-referencia">
                                    @if (r.ValorMinReferencia.HasValue || r.ValorMaxReferencia.HasValue)
                                    { <span>@(r.ValorMinReferencia?.ToString("G5") ?? "—") – @(r.ValorMaxReferencia?.ToString("G5") ?? "—")</span> }
                                    else { <span class="hr-sin-ref">sin ref.</span> }
                                </td>
                                <td class="hr-td-c">
                                    @if (r.EsPatologico)
                                    { <span class="hr-badge hr-badge-pato">&#9888; Sí</span> }
                                    else
                                    { <span class="hr-badge hr-badge-ok">&#10003; No</span> }
                                </td>
                                <td><span class="hr-periodo">@r.PeriodDate.ToString("MMM yyyy")</span></td>
                                <td><span class="hr-lote">@Trunc(r.Lote?.NombreArchivoOriginal ?? "—", 25)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="hr-pagination">
                <button class="hr-btn hr-btn-sm hr-btn-outline" @onclick="PaginaAnterior" disabled="@(Filtro.Pagina <= 1 || Cargando)">&#8592; Ant.</button>
                <span class="hr-pag-pages">
                    @{ var desde = Math.Max(1, Filtro.Pagina - 2); var hasta_ = Math.Min(TotalPaginasLista, Filtro.Pagina + 2); }
                    @if (desde > 1) { <span class="hr-ellipsis">…</span> }
                    @for (int pg = desde; pg <= hasta_; pg++) { var p = pg;
                        <button class="hr-btn hr-btn-sm @(p == Filtro.Pagina ? "hr-btn-pag-act" : "hr-btn-outline")"
                                @onclick="() => IrAPagina(p)">@p</button> }
                    @if (hasta_ < TotalPaginasLista) { <span class="hr-ellipsis">…</span> }
                </span>
                <button class="hr-btn hr-btn-sm hr-btn-outline" @onclick="PaginaSiguiente" disabled="@(Filtro.Pagina >= TotalPaginasLista || Cargando)">Sig. &#8594;</button>
            </div>
        </div>
    }
}

<!-- ═══ ESTILOS ═══════════════════════════════════════════════════════════════ -->
<style>
    /* ─ Header ───────────────────────────────────────────────── */
    .hr-header         { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:1rem; flex-wrap:wrap; gap:.75rem; }
    .hr-title          { font-size:1.75rem; font-weight:700; color:#1e293b; margin:0; }
    .hr-subtitle       { color:#64748b; margin:.2rem 0 0; font-size:.85rem; }
    .hr-header-actions { display:flex; align-items:center; gap:.5rem; flex-wrap:wrap; }

    /* ─ Toggle vista ──────────────────────────────────────────── */
    .hr-vista-toggle { display:flex; background:#f1f5f9; border-radius:8px; padding:3px; gap:2px; }
    .hr-vista-btn    { display:inline-flex; align-items:center; gap:.4rem; padding:.35rem .75rem;
                       border-radius:6px; border:none; background:transparent; cursor:pointer;
                       font-size:.8rem; font-weight:600; color:#64748b; transition:all .15s; }
    .hr-vista-active { background:white; color:#0ea5e9; box-shadow:0 1px 3px rgba(0,0,0,.1); }

    /* ─ Card base ────────────────────────────────────────────── */
    .hr-card { background:white; border-radius:12px; box-shadow:0 1px 3px rgba(0,0,0,.08); overflow:hidden; margin-bottom:1rem; }

    /* ════════════════════════════════════════════════════════════
       PANEL DE FILTROS PIVOT
    ═══════════════════════════════════════════════════════════ */
    .hr-fpanel { padding:0; }

    /* Cada bloque del panel */
    .hr-fp-bloque {
        padding:.75rem 1.25rem;
        display:flex;
        align-items:center;
        gap:.875rem;
        border-bottom:1px solid #f1f5f9;
    }
    .hr-fp-bloque:last-child { border-bottom:none; }

    /* Etiqueta de sección */
    .hr-fp-etiqueta {
        font-size:.62rem;
        font-weight:800;
        letter-spacing:.08em;
        color:#94a3b8;
        text-transform:uppercase;
        white-space:nowrap;
        width:80px;
        flex-shrink:0;
        line-height:1;
    }

    /* ─ BLOQUE 1: Período ───────────────────────────────────── */
    .hr-fp-periodo-inner {
        display:flex;
        align-items:center;
        gap:.625rem;
        flex:1;
        min-width:0;
    }

    .hr-year-sel {
        flex-shrink:0;
        width:86px;
        border:1.5px solid #e2e8f0;
        border-radius:8px;
        padding:.375rem .5rem;
        font-size:.9rem;
        font-weight:700;
        color:#1e293b;
        background:white;
        outline:none;
        cursor:pointer;
    }
    .hr-year-sel:focus { border-color:#0ea5e9; }

    /* Grid de 12 meses — ocupa todo el espacio restante */
    .hr-months-grid {
        display:grid;
        grid-template-columns:repeat(12, 1fr);
        gap:4px;
        flex:1;
        min-width:0;
    }

    .hr-month-btn {
        padding:.35rem 0;
        border-radius:6px;
        border:1.5px solid #e2e8f0;
        background:white;
        color:#64748b;
        font-size:.72rem;
        font-weight:600;
        cursor:pointer;
        text-align:center;
        transition:all .12s;
        white-space:nowrap;
    }
    .hr-month-btn:hover  { background:#f1f5f9; border-color:#cbd5e1; color:#374151; }
    .hr-month-on         { background:#dbeafe !important; border-color:#93c5fd !important; color:#1d4ed8 !important; font-weight:700; }

    /* ─ BLOQUE 2: Controles ─────────────────────────────────── */
    .hr-fp-controles { flex-wrap:wrap; }

    .hr-fp-grupo { display:flex; flex-direction:column; gap:.35rem; }
    .hr-fp-search-grupo { flex:1; min-width:200px; max-width:300px; }

    /* Chips de tipo de atención */
    .hr-tipo-btns { display:flex; gap:.3rem; flex-wrap:wrap; }
    .hr-tbtn {
        padding:.3rem .75rem;
        border-radius:20px;
        border:1.5px solid #e2e8f0;
        background:white;
        color:#64748b;
        font-size:.78rem;
        font-weight:600;
        cursor:pointer;
        transition:all .12s;
        white-space:nowrap;
    }
    .hr-tbtn:hover  { background:#f1f5f9; color:#374151; border-color:#cbd5e1; }
