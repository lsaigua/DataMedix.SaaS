    .hr-error-banner  { background:#fee2e2; color:#991b1b; border-radius:8px; padding:.75rem 1rem;
                        margin-bottom:1rem; display:flex; gap:.75rem; align-items:center; font-size:.875rem; }
    .hr-error-banner button { margin-left:auto; background:none; border:none; cursor:pointer; }
</style>

@code {
    // ── Modo vista ─────────────────────────────────────────────────────────────
    private string _vista = "pivot"; // "pivot" | "lista"
    private Guid TenantId;

    // ── Pivot state ────────────────────────────────────────────────────────────
    private int _pivotMes  = DateTime.Today.Month;
    private int _pivotAnio = DateTime.Today.Year;
    private string _filtroTipo        = "";
    private string _filtroNombrePivot = "";
    private List<ResultadoLaboratorio> _rawResultados = new();
    private List<PivotFila>   _filasPivot    = new();
    private List<PivotColumna> _columnasPivot = new();
    private List<string> _tiposAtencion = new();
    private int _pivotPagina = 1;
    private const int PivotTamano = 50;
    private int TotalPaginasPivot => Math.Max(1, (int)Math.Ceiling(_filasPivot.Count / (double)PivotTamano));
    private List<PivotFila> PaginaPivot => _filasPivot.Skip((_pivotPagina - 1) * PivotTamano).Take(PivotTamano).ToList();

    // ── Lista state ────────────────────────────────────────────────────────────
    private List<ResultadoLaboratorio> Resultados  = new();
    private List<ParametroClinico>     Parametros  = new();
    private List<LoteImportacion>      Lotes       = new();
    private ResultadoFiltro            Filtro      = new();
    private string  BusquedaPaciente   = string.Empty;
    private int     Total              = 0;
    private int     TotalPaginasLista  => Total == 0 ? 1 : (int)Math.Ceiling(Total / (double)Filtro.Tamano);
    private bool    Cargando           = true;
    private string? ErrorMensaje;
    private System.Threading.CancellationTokenSource? _debounce;

    protected override async Task OnInitializedAsync()
    {
        var auth      = await AuthState.GetAuthenticationStateAsync();
        var tenantStr = auth.User.FindFirst("tenant_id")?.Value;
        TenantId = Guid.TryParse(tenantStr, out var t) ? t : Guid.Empty;

        Parametros = await ParametroRepo.GetAllAsync();
        Lotes      = await LoteRepo.GetByTenantAsync(TenantId, 1, 100);

        await CargarPivotAsync();
    }

    // ── Cambio de vista ────────────────────────────────────────────────────────

    private async Task SetVista(char v)
    {
        _vista = v == 'p' ? "pivot" : "lista";
        if (_vista == "lista" && !Resultados.Any())
            await CargarListaAsync();
    }

    private async Task RefrescarAsync()
    {
        if (_vista == "pivot") await CargarPivotAsync();
        else await CargarListaAsync();
    }

    // ── PIVOT: carga y construcción ───────────────────────────────────────────

    private async Task CargarPivotAsync()
    {
        Cargando = true;
        ErrorMensaje = null;
        StateHasChanged();
        try
        {
            var filtro = new ResultadoFiltro
            {
                MesDe    = _pivotMes,  AnioDe    = _pivotAnio,
                MesHasta = _pivotMes,  AnioHasta = _pivotAnio,
                Tamano   = 10_000
            };
            _rawResultados = await ResultadoRepo.GetForExportAsync(TenantId, filtro);
            _tiposAtencion = _rawResultados.Select(r => r.TipoAtencion).Where(x => x != null)
                                           .Distinct().OrderBy(x => x).Select(x => x!).ToList();
            ConstruirPivot();
        }
        catch (Exception ex) { ErrorMensaje = ex.Message; }
        finally { Cargando = false; }
    }

    private void ConstruirPivot()
    {
        var datos = _rawResultados.AsEnumerable();
        if (!string.IsNullOrEmpty(_filtroTipo))
            datos = datos.Where(r => r.TipoAtencion == _filtroTipo);
        if (!string.IsNullOrWhiteSpace(_filtroNombrePivot))
        {
            var b = _filtroNombrePivot.Trim().ToUpperInvariant();
            datos = datos.Where(r =>
                r.Paciente.Identificacion.ToUpperInvariant().Contains(b) ||
                r.Paciente.NombreCompleto.ToUpperInvariant().Contains(b));
        }
        var lista = datos.ToList();

        // Columnas: un PivotColumna por parámetro único (por ParametroClinicoId o ParametroRaw)
        _columnasPivot = lista
            .GroupBy(r => r.ParametroClinicoId.HasValue
                ? r.ParametroClinicoId.Value.ToString()
                : "__" + (r.ParametroRaw?.Trim().ToUpperInvariant() ?? "?"))
            .Select(g =>
            {
                var first = g.First();
                var nombre = first.ParametroClinico?.Nombre ?? first.ParametroRaw ?? "?";
                return new PivotColumna
                {
                    Key        = g.Key,
                    Codigo     = first.ParametroClinico?.Codigo ?? "",
                    Nombre     = nombre,
                    NombreCorto = nombre.Length > 10 ? nombre[..10] + "." : nombre,
                    Orden      = first.ParametroClinico?.OrdenVisualizacion ?? 9999
                };
            })
            .OrderBy(c => c.Orden).ThenBy(c => c.Nombre)
            .ToList();

        // Filas: un PivotFila por paciente
        _filasPivot = lista
            .GroupBy(r => r.PacienteId)
            .Select(g =>
            {
                var first = g.First();
                var fila = new PivotFila
                {
                    PacienteId   = g.Key,
                    Identificacion = first.Paciente.Identificacion,
                    Nombre       = first.Paciente.NombreCompleto,
                    TipoAtencion = first.TipoAtencion,
                    PlanSalud    = first.PlanSalud
                };
                foreach (var r in g)
                {
                    var key = r.ParametroClinicoId.HasValue
                        ? r.ParametroClinicoId.Value.ToString()
                        : "__" + (r.ParametroRaw?.Trim().ToUpperInvariant() ?? "?");
                    fila.Celdas[key] = new PivotCelda(r.ValorNumerico, r.UnidadMedida, r.EsPatologico, r.ResultadoTexto);
                    if (r.EsPatologico) fila.TienePatologico = true;
                }
                return fila;
            })
            .OrderBy(f => f.TipoAtencion).ThenBy(f => f.Nombre)
            .ToList();

        _pivotPagina = 1;
    }

    private void FiltrarPivot() { ConstruirPivot(); StateHasChanged(); }

    private System.Threading.CancellationTokenSource? _pivotDebounce;
    private async Task OnBusquedaPivotChange()
    {
        _pivotDebounce?.Cancel(); _pivotDebounce?.Dispose();
        _pivotDebounce = new System.Threading.CancellationTokenSource();
        var token = _pivotDebounce.Token;
        try
        {
            await Task.Delay(350, token);
            FiltrarPivot();
        }
        catch (TaskCanceledException) { }
    }

    private void PivotAnterior()   { if (_pivotPagina > 1) _pivotPagina--; }
    private void PivotSiguiente()  { if (_pivotPagina < TotalPaginasPivot) _pivotPagina++; }

    // ── LISTA: carga ───────────────────────────────────────────────────────────

    private async Task CargarListaAsync()
    {
        Cargando = true;
        ErrorMensaje = null;
        StateHasChanged();
        try   { (Resultados, Total) = await ResultadoRepo.GetPagedAsync(TenantId, Filtro); }
        catch (Exception ex) { ErrorMensaje = ex.Message; }
        finally { Cargando = false; }
    }

    private async Task BuscarDebounced()
    {
        Filtro.BusquedaPaciente = BusquedaPaciente; Filtro.Pagina = 1;
        _debounce?.Cancel(); _debounce?.Dispose();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(350, token); await CargarListaAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task PaginaAnterior()  { if (Filtro.Pagina > 1) { Filtro.Pagina--; await CargarListaAsync(); } }
    private async Task PaginaSiguiente() { if (Filtro.Pagina < TotalPaginasLista) { Filtro.Pagina++; await CargarListaAsync(); } }
    private async Task IrAPagina(int p)  { Filtro.Pagina = p; await CargarListaAsync(); }

    private async Task OnParametroChange(ChangeEventArgs e)
    { Filtro.ParametroClinicoId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task OnMesDesdeChange(ChangeEventArgs e)
    { Filtro.MesDe = int.TryParse(e.Value?.ToString(), out var i) ? i : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task OnAnioDesdeChange(ChangeEventArgs e)
    { Filtro.AnioDe = int.TryParse(e.Value?.ToString(), out var i) ? i : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task OnMesHastaChange(ChangeEventArgs e)
    { Filtro.MesHasta = int.TryParse(e.Value?.ToString(), out var i) ? i : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task OnAnioHastaChange(ChangeEventArgs e)
    { Filtro.AnioHasta = int.TryParse(e.Value?.ToString(), out var i) ? i : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task OnLoteChange(ChangeEventArgs e)
    { Filtro.LoteId = Guid.TryParse(e.Value?.ToString(), out var g) ? g : null; Filtro.Pagina = 1; await CargarListaAsync(); }
    private async Task LimpiarFiltros() { Filtro = new ResultadoFiltro(); BusquedaPaciente = string.Empty; await CargarListaAsync(); }

    // ── Exportar ───────────────────────────────────────────────────────────────

    private void ExportarExcel()
    {
        if (_vista == "pivot")
        {
            var url = $"/api/reportes/resultados-excel?mesDe={_pivotMes}&anioDe={_pivotAnio}&mesHasta={_pivotMes}&anioHasta={_pivotAnio}";
            Nav.NavigateTo(url, forceLoad: true);
            return;
        }
        var qs = new List<string>();
        if (!string.IsNullOrWhiteSpace(Filtro.BusquedaPaciente)) qs.Add($"busquedaPaciente={Uri.EscapeDataString(Filtro.BusquedaPaciente)}");
        if (Filtro.ParametroClinicoId.HasValue) qs.Add($"parametroClinicoId={Filtro.ParametroClinicoId}");
        if (Filtro.AnioDe.HasValue)   qs.Add($"anioDe={Filtro.AnioDe}");
        if (Filtro.MesDe.HasValue)    qs.Add($"mesDe={Filtro.MesDe}");
        if (Filtro.AnioHasta.HasValue) qs.Add($"anioHasta={Filtro.AnioHasta}");
        if (Filtro.MesHasta.HasValue)  qs.Add($"mesHasta={Filtro.MesHasta}");
        if (Filtro.LoteId.HasValue)   qs.Add($"loteId={Filtro.LoteId}");
        Nav.NavigateTo("/api/reportes/resultados-excel" + (qs.Any() ? "?" + string.Join("&", qs) : ""), forceLoad: true);
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string NombreMes(int m) => m switch
    {
        1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril",
        5 => "Mayo", 6 => "Junio", 7 => "Julio", 8 => "Agosto",
        9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre",
        _ => m.ToString()
    };

    private static string Trunc(string? s, int max) =>
        string.IsNullOrEmpty(s) ? "—" : s.Length > max ? s[..max] + "…" : s;

    public void Dispose() { _debounce?.Dispose(); _pivotDebounce?.Dispose(); }

    // ── Tipos internos para pivot ──────────────────────────────────────────────

    private class PivotFila
    {
        public Guid   PacienteId    { get; set; }
        public string Identificacion { get; set; } = "";
        public string Nombre        { get; set; } = "";
        public string? TipoAtencion { get; set; }
        public string? PlanSalud    { get; set; }
        public bool   TienePatologico { get; set; }
        public Dictionary<string, PivotCelda> Celdas { get; set; } = new();
    }

    private record PivotCelda(decimal? Valor, string? Unidad, bool EsPatologico, string? Texto);

    private class PivotColumna
    {
        public string Key        { get; set; } = "";
        public string Codigo     { get; set; } = "";
        public string Nombre     { get; set; } = "";
        public string NombreCorto { get; set; } = "";
        public int    Orden      { get; set; }
    }
}
