@code {
    // ── Estado general ───────────────────────────────────────────────────────
    private List<Paciente> ListaPacientes = new();
    private bool     Cargando       = true;
    private string   BusquedaTexto  = string.Empty;
    private int      TotalPacientes = 0;
    private int      PaginaActual   = 1;
    private int      TotalPaginas   = 1;
    private const int TamanoPagina  = 25;
    private Guid     TenantId;
    private Guid     UsuarioId;
    private System.Threading.CancellationTokenSource? _debounce;

    // ── Estado de modales ─────────────────────────────────────────────────────
    private bool      _mostrarModal  = false;
    private bool      _editando      = false;
    private bool      _guardando     = false;
    private string    _error         = string.Empty;
    private string    _exito         = string.Empty;
    private string    _modalError    = string.Empty;
    private string?   _campoRequerido;
    private Paciente? _pacienteAEliminar;
    private Guid?     _pacienteEditId;

    // ── Formulario ────────────────────────────────────────────────────────────
    private PacienteForm _form = new();

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var tenantStr  = auth.User.FindFirst("tenant_id")?.Value;
        var usuarioStr = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        TenantId  = Guid.TryParse(tenantStr,  out var t) ? t : Guid.Empty;
        UsuarioId = Guid.TryParse(usuarioStr, out var u) ? u : Guid.Empty;
        await CargarPacientesAsync();
    }

    // ── Carga y paginación ────────────────────────────────────────────────────

    private async Task CargarPacientesAsync()
    {
        Cargando = true;
        StateHasChanged();
        try
        {
            TotalPacientes = await PacienteRepo.CountAsync(TenantId, BusquedaTexto);
            TotalPaginas   = Math.Max(1, (int)Math.Ceiling((double)TotalPacientes / TamanoPagina));
            if (PaginaActual > TotalPaginas) PaginaActual = 1;
            ListaPacientes = await PacienteRepo.GetAllAsync(TenantId, BusquedaTexto, PaginaActual, TamanoPagina);
        }
        finally { Cargando = false; }
    }

    private async Task BuscarDebounced()
    {
        _debounce?.Cancel(); _debounce?.Dispose();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;
        try { await Task.Delay(400, token); PaginaActual = 1; await CargarPacientesAsync(); }
        catch (TaskCanceledException) { }
    }

    private async Task LimpiarBusqueda()
    { BusquedaTexto = string.Empty; PaginaActual = 1; await CargarPacientesAsync(); }

    private async Task PaginaAnterior()
    { if (PaginaActual > 1) { PaginaActual--; await CargarPacientesAsync(); } }

    private async Task PaginaSiguiente()
    { if (PaginaActual < TotalPaginas) { PaginaActual++; await CargarPacientesAsync(); } }

    // ── Modales crear / editar ─────────────────────────────────────────────────

    private void AbrirModalCrear()
    {
        _form           = new PacienteForm();
        _editando       = false;
        _pacienteEditId = null;
        _modalError     = string.Empty;
        _campoRequerido = null;
        _mostrarModal   = true;
    }

    private void AbrirModalEditar(Paciente p)
    {
        _form = new PacienteForm
        {
            Identificacion    = p.Identificacion,
            PrimerNombre      = p.PrimerNombre,
            SegundoNombre     = p.SegundoNombre,
            PrimerApellido    = p.PrimerApellido,
            SegundoApellido   = p.SegundoApellido,
            FechaNacimiento   = p.FechaNacimiento,
            Genero            = p.Genero,
            Email             = p.Email,
            Telefono          = p.Telefono,
            PlanSalud         = p.PlanSalud,
            TipoAtencion      = p.TipoAtencion,
            FechaIngreso      = p.FechaIngreso,
            MedicoResponsable = p.MedicoResponsable,
            Observaciones     = p.Observaciones,
        };
        _editando       = true;
        _pacienteEditId = p.Id;
        _modalError     = string.Empty;
        _campoRequerido = null;
        _mostrarModal   = true;
    }

    private void CerrarModal()
    {
        _mostrarModal = false;
        _modalError   = string.Empty;
    }

    private async Task GuardarPacienteAsync()
    {
        _modalError     = string.Empty;
        _campoRequerido = null;

        if (string.IsNullOrWhiteSpace(_form.Identificacion))
        { _modalError = "La identificación es requerida."; _campoRequerido = "identificacion"; return; }
        if (string.IsNullOrWhiteSpace(_form.PrimerNombre))
        { _modalError = "El primer nombre es requerido."; return; }
        if (string.IsNullOrWhiteSpace(_form.PrimerApellido))
        { _modalError = "El primer apellido es requerido."; return; }

        _guardando = true;
        try
        {
            if (_editando && _pacienteEditId.HasValue)
            {
                var p = await PacienteRepo.GetByIdAsync(TenantId, _pacienteEditId.Value);
                if (p is null) { _modalError = "Paciente no encontrado."; return; }

                p.Identificacion    = _form.Identificacion.Trim();
                p.PrimerNombre      = _form.PrimerNombre.Trim();
                p.SegundoNombre     = _form.SegundoNombre?.Trim();
                p.PrimerApellido    = _form.PrimerApellido.Trim();
                p.SegundoApellido   = _form.SegundoApellido?.Trim();
                p.FechaNacimiento   = _form.FechaNacimiento;
                p.Genero            = _form.Genero;
                p.Email             = _form.Email?.Trim();
                p.Telefono          = _form.Telefono?.Trim();
                p.PlanSalud         = _form.PlanSalud?.Trim();
                p.TipoAtencion      = _form.TipoAtencion?.Trim();
                p.FechaIngreso      = _form.FechaIngreso;
                p.MedicoResponsable = _form.MedicoResponsable?.Trim();
                p.Observaciones     = _form.Observaciones?.Trim();
                p.UpdatedAt         = DateTime.UtcNow;

                await PacienteRepo.UpdateAsync(p);
                await UoW.SaveChangesAsync();
                _exito = $"Paciente «{p.NombreCompleto}» actualizado.";
            }
            else
            {
                // Verificar duplicado
                var existente = await PacienteRepo.GetByIdentificacionAsync(TenantId, _form.Identificacion.Trim());
                if (existente != null)
                { _modalError = $"Ya existe un paciente con identificación {_form.Identificacion}."; return; }

                var nuevo = new Paciente
                {
                    TenantId          = TenantId,
                    Identificacion    = _form.Identificacion.Trim(),
                    PrimerNombre      = _form.PrimerNombre.Trim(),
                    SegundoNombre     = _form.SegundoNombre?.Trim(),
                    PrimerApellido    = _form.PrimerApellido.Trim(),
                    SegundoApellido   = _form.SegundoApellido?.Trim(),
                    FechaNacimiento   = _form.FechaNacimiento,
                    Genero            = _form.Genero,
                    Email             = _form.Email?.Trim(),
                    Telefono          = _form.Telefono?.Trim(),
                    PlanSalud         = _form.PlanSalud?.Trim(),
                    TipoAtencion      = _form.TipoAtencion?.Trim(),
                    FechaIngreso      = _form.FechaIngreso,
                    MedicoResponsable = _form.MedicoResponsable?.Trim(),
                    Observaciones     = _form.Observaciones?.Trim(),
                    CreatedBy         = UsuarioId,
                };
                await PacienteRepo.AddAsync(nuevo);
                await UoW.SaveChangesAsync();
                _exito = $"Paciente «{nuevo.NombreCompleto}» creado exitosamente.";
            }

            _mostrarModal = false;
            await CargarPacientesAsync();
        }
        catch (Exception ex)
        {
            _modalError = $"Error al guardar: {ex.Message}";
        }
        finally { _guardando = false; }
    }

    // ── Eliminar (soft delete) ─────────────────────────────────────────────────

    private void PedirConfirmarEliminar(Paciente p) => _pacienteAEliminar = p;

    private async Task EliminarConfirmadoAsync()
    {
        if (_pacienteAEliminar is null) return;
        _guardando = true;
        try
        {
            await PacienteRepo.DeleteAsync(TenantId, _pacienteAEliminar.Id);
            await UoW.SaveChangesAsync();
            _exito = $"Paciente «{_pacienteAEliminar.NombreCompleto}» desactivado.";
            _pacienteAEliminar = null;
            await CargarPacientesAsync();
        }
        catch (Exception ex) { _error = $"Error al desactivar: {ex.Message}"; }
        finally { _guardando = false; }
    }

    // ── Helpers ────────────────────────────────────────────────────────────────

    private static string InicialPaciente(Paciente p) =>
        (!string.IsNullOrEmpty(p.PrimerNombre) ? p.PrimerNombre[0].ToString() : "?").ToUpper();

    private static string FormatarMeses(int m) =>
        m < 12 ? $"{m}m" : $"{m / 12}a {m % 12}m".Replace(" 0m", "");

    // ── Clase interna del formulario ───────────────────────────────────────────
    private class PacienteForm
    {
        public string    Identificacion    { get; set; } = string.Empty;
        public string    PrimerNombre      { get; set; } = string.Empty;
        public string?   SegundoNombre     { get; set; }
        public string    PrimerApellido    { get; set; } = string.Empty;
        public string?   SegundoApellido   { get; set; }
        public DateTime? FechaNacimiento   { get; set; }
        public string?   Genero            { get; set; }
        public string?   Email             { get; set; }
        public string?   Telefono          { get; set; }
        public string?   PlanSalud         { get; set; }
        public string?   TipoAtencion      { get; set; }
        public DateTime? FechaIngreso      { get; set; }
        public string?   MedicoResponsable { get; set; }
        public string?   Observaciones     { get; set; }
    }
}
