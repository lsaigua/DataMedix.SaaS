@page "/cronograma-medicacion"
@using DataMedix.Application.Services
@using DataMedix.Application.Interfaces
@using DataMedix.Domain.Entities
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
@attribute [Authorize(Policy = "perm:cronograma.ver")]
@inject CronogramaService CronogramaService
@inject IConfiguracionMedicamentoRepository ConfigRepo
@inject ISnapshotMensualRepository SnapshotRepo
@inject GlobalToastService Toast
@inject GlobalLoadingService Loading
@inject AuthenticationStateProvider AuthProvider
@inject IJSRuntime JS
@inject IPrecioEpoDosisRepository PrecioEpoDosisRepo
@inject IEventoDosisPendienteRepository EventoRepo

<PageTitle>Cronograma de Medicación — DataMedix</PageTitle>

<div class="crono-page">

    <!-- ═══ HEADER ═══════════════════════════════════════════════════════════ -->
    <div class="crono-header">
        <div class="crono-header-left">
            <h1 class="crono-title">Cronograma de Medicación</h1>
            <p class="crono-subtitle">EPO · Hierro IV · @SubtituloModo</p>
        </div>
        <div class="crono-header-actions">
            <input type="text" class="crono-busqueda" placeholder="Buscar cédula o nombre..."
                   @bind="_busqueda" @bind:event="oninput" />

            <!-- Selector de modo: Mensual / Flexible -->
            <div class="crono-modo-toggle" title="Modo de generación del cronograma">
                <button class="crono-modo-btn @(_modo == 0 ? "crono-modo-active" : "")"
                        @onclick='() => _modo = 0' title="Calendario mensual (del 1 al fin del mes)">
                    Mensual
                </button>
                <button class="crono-modo-btn @(_modo == 1 ? "crono-modo-active" : "")"
                        @onclick='() => _modo = 1' title="Cronograma flexible (fecha libre, duración 1 mes)">
                    Flexible
                </button>
            </div>

            @if (_modo == 0)
            {
                <select class="crono-select" @bind="_mes">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@NombreMes(m)</option>
                    }
                </select>
                <select class="crono-select" @bind="_anio">
                    @for (int a = DateTime.Today.Year - 1; a <= DateTime.Today.Year + 1; a++)
                    {
                        <option value="@a">@a</option>
                    }
                </select>
            }
            else
            {
                <input type="date" class="crono-select crono-fecha-flex"
                       value="@_fechaInicioFlex.ToString("yyyy-MM-dd")"
                       @onchange="OnFechaFlexChange" />
                <span class="crono-flex-hasta" title="Fecha fin calculada automáticamente">
                    hasta @FechaFinFlex.ToString("dd/MM/yy")
                </span>
            }

            <button class="crono-btn crono-btn-primary" @onclick="GenerarCronogramaAsync" disabled="@_cargando">
                @if (_cargando)
                {
                    <span class="crono-spinner"></span>
                }
                Generar / Actualizar
            </button>
            <button class="crono-btn crono-btn-secondary" @onclick="ExportarExcelAsync" disabled="@(_cronogramas.Count == 0)">
                Exportar Excel
            </button>
            <button class="crono-btn crono-btn-ghost" @onclick="() => _showConfig = !_showConfig">
                Precios
            </button>
            @if (_cronogramas.Count > 0)
            {
                // Total en el botón: al mover los KPI al modal, la cifra clave
                // debe seguir estando a la vista sin abrirlo.
                var (rvBtn, _, _) = ComputarResumenYDesglose();
                <button class="crono-btn crono-btn-resumen" @onclick="() => _showResumen = true"
                        title="Ver resumen y desglose de costos del período">
                    <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 16V9M8 16V4M13 16v-5M18 16v-9" />
                    </svg>
                    Resumen
                    @if (rvBtn != null && (_preciosEpo.Values.Any(v => v > 0) || _precioHierro > 0))
                    {
                        <span class="crono-btn-badge">$ @rvBtn.CostoTotal.ToString("N2")</span>
                    }
                </button>
            }
        </div>
    </div>

    <!-- ═══ PANEL PRECIOS ════════════════════════════════════════════════════ -->
    @if (_showConfig)
    {
        <div class="crono-config-panel">
            <div class="crono-config-title">Configuración de Precios</div>
            <div class="crono-config-epo-section">
                <div class="crono-config-epo-label">EPO — precio por aplicación (dólares):</div>
                <table class="crono-config-epo-table">
                    <thead><tr><th>Dosis UI</th><th>Precio por aplicación</th></tr></thead>
                    <tbody>
                        @foreach (var dosis in _dosisEpoConfig)
                        {
                            var localDosis = dosis;
                            <tr>
                                <td>@localDosis.DosisUI.ToString("N0") UI</td>
                                <td>
                                    <div class="crono-config-money">
                                        <span class="crono-config-money-sign">$</span>
                                        @* type=text: con type=number el navegador muestra el
                                           separador decimal de su idioma y 2.80 se lee "2,8000" *@
                                        <input type="text" inputmode="decimal" class="crono-config-input"
                                               value="@Money(localDosis.Precio)"
                                               @onchange="e => localDosis.Precio = ParseDecimal(e.Value?.ToString()) ?? 0" />
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p class="crono-config-hint">
                    Cada aplicación cuesta este valor completo:
                    @if (_dosisEpoConfig.Count > 0)
                    {
                        var ej = _dosisEpoConfig[0];
                        <text>10 aplicaciones de @ej.DosisUI.ToString("N0") UI = $ @((ej.Precio * 10).ToString("N2")).</text>
                    }
                </p>
            </div>
            <div class="crono-config-row">
                <label>Hierro — precio por ampolla (100 mg):</label>
                <div class="crono-config-money">
                    <span class="crono-config-money-sign">$</span>
                    <input type="text" inputmode="decimal" class="crono-config-input"
                           value="@Money(_precioHierro)"
                           @onchange="e => _precioHierro = ParseDecimal(e.Value?.ToString()) ?? 0" />
                </div>
                <span class="crono-config-hint crono-config-hint-inline">
                    400 mg = 4 ampollas = $ @CostoHierro(400m).ToString("N2")
                </span>
            </div>
            <div class="crono-config-actions">
                <button class="crono-btn crono-btn-primary" @onclick="GuardarPreciosAsync">Guardar</button>
                <button class="crono-btn crono-btn-ghost" @onclick="() => _showConfig = false">Cerrar</button>
            </div>
        </div>
    }

    <!-- ═══ MODAL: RESUMEN DE COSTOS + DESGLOSE POR DOSIS ══════════════════ -->
    @if (_showResumen && _cronogramas.Count > 0)
    {
        var (rv, desglose, desglPend) = ComputarResumenYDesglose();
        <div class="crono-resumen-overlay" @onclick="() => _showResumen = false">
        <div class="crono-resumen-modal" @onclick:stopPropagation="true">

            <div class="crono-resumen-modal-header">
                <div>
                    <h2 class="crono-resumen-modal-title">Resumen del período</h2>
                    <p class="crono-resumen-modal-sub">
                        @NombreMes(_mes) @_anio · @SubtituloModo
                    </p>
                </div>
                <button class="crono-resumen-modal-close" @onclick="() => _showResumen = false"
                        title="Cerrar" aria-label="Cerrar resumen">&times;</button>
            </div>

            <div class="crono-resumen-modal-body">
        @if (rv != null)
        {
            bool hayFiltro = _filtroTurno != "Todos" || _filtroDia != 0 ||
                             _filtroSala != "Todas" || !string.IsNullOrWhiteSpace(_busqueda) ||
                             TieneFiltroFecha;
            @if (hayFiltro)
            {
                <div class="crono-resumen-modal-aviso">
                    Los valores corresponden a los filtros activos, no a todo el mes.
                </div>
            }
            <div class="crono-resumen @(hayFiltro ? "crono-resumen-filtrado" : "")">
                <div class="crono-resumen-item">
                    <span class="crono-resumen-label">Pacientes</span>
                    <span class="crono-resumen-value">@rv.TotalPacientes</span>
                </div>
                <div class="crono-resumen-item">
                    <span class="crono-resumen-label">Sesiones</span>
                    <span class="crono-resumen-value">@rv.TotalSesiones.ToString("N0")</span>
                </div>
                <div class="crono-resumen-item">
                    <span class="crono-resumen-label">Total EPO</span>
                    <span class="crono-resumen-value">@rv.TotalEpoUI.ToString("N0") UI</span>
                </div>
                <div class="crono-resumen-item">
                    <span class="crono-resumen-label">Total Hierro</span>
                    <span class="crono-resumen-value">@rv.TotalHierroMg.ToString("N0") mg</span>
                </div>
                @if (_preciosEpo.Values.Any(v => v > 0) || _precioHierro > 0)
                {
                    <div class="crono-resumen-item">
                        <span class="crono-resumen-label">Costo EPO</span>
                        <span class="crono-resumen-value crono-cost">$ @rv.CostoEpo.ToString("N2")</span>
                    </div>
                    <div class="crono-resumen-item">
                        <span class="crono-resumen-label">Costo Hierro</span>
                        <span class="crono-resumen-value crono-cost">$ @rv.CostoHierro.ToString("N2")</span>
                    </div>
                    <div class="crono-resumen-item crono-resumen-total">
                        <span class="crono-resumen-label">TOTAL @(hayFiltro ? "▼" : "")</span>
                        <span class="crono-resumen-value">$ @rv.CostoTotal.ToString("N2")</span>
                    </div>
                }
            </div>
        }

        <!-- Resumen costos por dosis administrada -->
        @if (desglose.Count > 0)
        {
            bool hayCostos     = _preciosEpo.Values.Any(v => v > 0);
            var  admAplic      = desglose.Sum(r => r.Aplicaciones);
            var  admUI         = desglose.Sum(r => r.TotalUI);
            var  admCosto      = desglose.Sum(r => r.Costo);
            <section class="crono-desglose-epo @(_showResumenEpo ? "" : "crono-desglose-colapsado")">
                <button type="button"
                        class="crono-desglose-epo-header"
                        id="crono-desglose-adm-btn"
                        aria-expanded="@(_showResumenEpo ? "true" : "false")"
                        aria-controls="crono-desglose-adm-body"
                        title="@(_showResumenEpo ? "Ocultar el detalle por dosis" : "Mostrar el detalle por dosis")"
                        @onclick="ToggleResumenEpoAsync">
                    <span class="crono-desglose-chevron" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 8l4 4 4-4" />
                        </svg>
                    </span>
                    <span class="crono-desglose-epo-titulo">Resumen EPO</span>
                    <span class="crono-desglose-epo-sub">por dosis administrada</span>

                    <!-- Cifras clave siempre visibles: colapsar no debe esconder el dato -->
                    <span class="crono-desglose-peek">
                        <span class="crono-peek-chip">@admAplic.ToString("N0") aplic.</span>
                        <span class="crono-peek-chip">@admUI.ToString("N0") UI</span>
                        @if (hayCostos)
                        {
                            <span class="crono-peek-chip crono-peek-costo">$ @admCosto.ToString("N2")</span>
                        }
                    </span>
                </button>
                <div class="crono-desglose-epo-body" id="crono-desglose-adm-body"
                     role="region" aria-labelledby="crono-desglose-adm-btn">
                <div class="crono-desglose-epo-body-inner">
                <table class="crono-desglose-epo-table">
                    <thead>
                        <tr>
                            <th>Dosis UI</th>
                            <th>Aplicaciones</th>
                            <th>Total UI</th>
                            @if (hayCostos) { <th title="Precio de una aplicación">Precio x aplic.</th><th>Costo</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in desglose)
                        {
                            <tr>
                                <td class="crono-desglose-epo-dosis">@fila.DosisUI.ToString("N0") UI</td>
                                <td class="crono-desglose-epo-num">@fila.Aplicaciones</td>
                                <td class="crono-desglose-epo-num">@fila.TotalUI.ToString("N0")</td>
                                @if (hayCostos)
                                {
                                    <td class="crono-desglose-epo-costo">$ @fila.Precio.ToString("N2")</td>
                                    <td class="crono-desglose-epo-costo">$ @fila.Costo.ToString("N2")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="crono-desglose-epo-total-label">TOTAL</td>
                            <td class="crono-desglose-epo-num crono-desglose-epo-total-val">@admAplic</td>
                            <td class="crono-desglose-epo-num crono-desglose-epo-total-val">@admUI.ToString("N0")</td>
                            @if (hayCostos)
                            {
                                <td></td>
                                <td class="crono-desglose-epo-costo crono-desglose-epo-total-val">$ @admCosto.ToString("N2")</td>
                            }
                        </tr>
                    </tfoot>
                </table>
                </div>
                </div>
            </section>
        }

        <!-- Resumen dosis pendientes NO administradas -->
        @if (desglPend.Count > 0)
        {
            bool hayCostosPend = _preciosEpo.Values.Any(v => v > 0);
            var  pendPac       = desglPend.Sum(r => r.Aplicaciones);
            var  pendUI        = desglPend.Sum(r => r.TotalUI);
            var  pendCosto     = desglPend.Sum(r => r.Costo);
            <section class="crono-desglose-epo crono-desglose-pend @(_showEpoPendiente ? "" : "crono-desglose-colapsado")">
                <button type="button"
                        class="crono-desglose-epo-header"
                        id="crono-desglose-pend-btn"
                        aria-expanded="@(_showEpoPendiente ? "true" : "false")"
                        aria-controls="crono-desglose-pend-body"
                        title="@(_showEpoPendiente ? "Ocultar el detalle de dosis pendientes" : "Mostrar el detalle de dosis pendientes")"
                        @onclick="ToggleEpoPendienteAsync">
                    <span class="crono-desglose-chevron" aria-hidden="true">
                        <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"
                             stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 8l4 4 4-4" />
                        </svg>
                    </span>
                    <span class="crono-desglose-epo-titulo">EPO Pendiente</span>
                    <span class="crono-desglose-epo-sub">dosis no administrada — compensación programada</span>

                    <span class="crono-desglose-peek">
                        <span class="crono-peek-chip">@pendPac.ToString("N0") pac.</span>
                        <span class="crono-peek-chip">@pendUI.ToString("N0") UI</span>
                        @if (hayCostosPend)
                        {
                            <span class="crono-peek-chip crono-peek-costo">$ @pendCosto.ToString("N2")</span>
                        }
                    </span>
                </button>
                <div class="crono-desglose-epo-body" id="crono-desglose-pend-body"
                     role="region" aria-labelledby="crono-desglose-pend-btn">
                <div class="crono-desglose-epo-body-inner">
                <table class="crono-desglose-epo-table">
                    <thead>
                        <tr>
                            <th>Dosis UI</th>
                            <th>Pacientes</th>
                            <th>Total UI</th>
                            @if (hayCostosPend) { <th title="Precio de una aplicación">Precio x aplic.</th><th>Costo potencial</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var fila in desglPend)
                        {
                            <tr>
                                <td class="crono-desglose-epo-dosis crono-desglose-pend-dosis">@fila.DosisUI.ToString("N0") UI</td>
                                <td class="crono-desglose-epo-num">@fila.Aplicaciones</td>
                                <td class="crono-desglose-epo-num">@fila.TotalUI.ToString("N0")</td>
                                @if (hayCostosPend)
                                {
                                    <td class="crono-desglose-epo-costo">$ @fila.Precio.ToString("N2")</td>
                                    <td class="crono-desglose-epo-costo crono-pend-costo-val">$ @fila.Costo.ToString("N2")</td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td class="crono-desglose-epo-total-label">TOTAL</td>
                            <td class="crono-desglose-epo-num crono-desglose-epo-total-val">@pendPac</td>
                            <td class="crono-desglose-epo-num crono-desglose-epo-total-val">@pendUI.ToString("N0")</td>
                            @if (hayCostosPend)
                            {
                                <td></td>
                                <td class="crono-desglose-epo-costo crono-desglose-epo-total-val crono-pend-costo-val">$ @pendCosto.ToString("N2")</td>
                            }
                        </tr>
                    </tfoot>
                </table>
                </div>
                </div>
            </section>
        }
            </div>

            <div class="crono-resumen-modal-footer">
                <button class="crono-btn crono-btn-ghost" @onclick="() => _showResumen = false">Cerrar</button>
            </div>
        </div>
        </div>
    }

    <!-- ═══ FILTROS DE SEGMENTO ════════════════════════════════════════════ -->
    @if (_cronogramas.Count > 0)
    {
        <div class="crono-filtros-bar">
            <div class="crono-filtros-grupo">
                <span class="crono-filtros-label">Turno:</span>
                @foreach (var turno in new[] { "Todos", "LMV", "MJS" })
                {
                    var localTurno = turno;
                    <button class="crono-seg-btn @(_filtroTurno == localTurno ? "crono-seg-active" : "")"
                            @onclick="() => _filtroTurno = localTurno">@localTurno</button>
                }
            </div>
            <div class="crono-filtros-grupo">
                <span class="crono-filtros-label">Día:</span>
                @foreach (var item in _diasFiltroOpciones)
                {
                    var localItem = item;
                    <button class="crono-seg-btn @(_filtroDia == localItem.Val ? "crono-seg-active" : "")"
                            @onclick="() => _filtroDia = localItem.Val">@localItem.Label</button>
                }
            </div>
            <div class="crono-filtros-grupo">
                <span class="crono-filtros-label">Sala:</span>
                <select class="crono-select crono-select-sala" @bind="_filtroSala">
                    @foreach (var s in _salasOpciones)
                    {
                        <option value="@s">@s</option>
                    }
                </select>
            </div>
            <div class="crono-filtros-grupo">
                <span class="crono-filtros-label">Desde:</span>
                <input type="date" class="crono-select crono-filtro-fecha"
                       value="@(_filtroFechaDesde?.ToString("yyyy-MM-dd") ?? "")"
                       @onchange="OnFiltroFechaDesdeChange" />
                <span class="crono-filtros-label crono-filtros-label-hasta">Hasta:</span>
                <input type="date" class="crono-select crono-filtro-fecha"
                       value="@(_filtroFechaHasta?.ToString("yyyy-MM-dd") ?? "")"
                       @onchange="OnFiltroFechaHastaChange" />
                @if (TieneFiltroFecha)
                {
                    <button class="crono-btn-clear-fecha" @onclick="LimpiarFiltroFecha" title="Limpiar rango de fechas">✕</button>
                }
            </div>
            <div class="crono-filtros-grupo crono-filtros-right">
                <button class="crono-btn crono-btn-ghost"
                        @onclick="() => _showGraficos = !_showGraficos">
                    @(_showGraficos ? "▲ Ocultar Gráficos" : "▼ Top 20 por Costo")
                </button>
            </div>
        </div>
    }

    <!-- ═══ GRÁFICOS DE COSTO ════════════════════════════════════════════ -->
    @if (_showGraficos && _cronogramas.Count > 0)
    {
        @if (!_preciosEpo.Values.Any(v => v > 0) && _precioHierro == 0)
        {
            <div class="crono-graficos-panel">
                <p class="crono-grafico-aviso">Configure los precios de EPO y Hierro (botón "Precios") para ver los gráficos de costo.</p>
            </div>
        }
        else
        {
            var lista20 = Top20Pacientes.ToList();
            if (lista20.Count > 0)
            {
                var maxCosto = lista20[0].Costo;
                <div class="crono-graficos-panel">
                    <div class="crono-grafico-titulo">
                        Top @lista20.Count — Pacientes Mayor Costo · @NombreMes(_mes) @_anio
                        <span class="crono-grafico-leyenda">
                            <span class="crono-leg-dot crono-leg-epo"></span> EPO &nbsp;
                            <span class="crono-leg-dot crono-leg-fe"></span> Hierro
                        </span>
                    </div>
                    <div class="crono-grafico-body">
                        @foreach (var p in lista20)
                        {
                            var wEpo = maxCosto > 0
                                ? (p.EpoCosto / maxCosto * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                                : "0";
                            var wFe = maxCosto > 0
                                ? (CostoHierro(p.TotalHierro) / maxCosto * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture)
                                : "0";
                            <div class="crono-barra-row">
                                <div class="crono-barra-nombre" title="@PacienteDisplay.Mask(p.Nombre) · @p.Cedula">
                                    @PacienteDisplay.Mask(p.Nombre, 22)
                                </div>
                                <div class="crono-barra-wrap">
                                    @if (p.EpoCosto > 0)
                                    {
                                        <div class="crono-barra-seg crono-barra-epo" style="width:@wEpo%"
                                             title="EPO $@(p.EpoCosto.ToString("N0"))"></div>
                                    }
                                    @if (CostoHierro(p.TotalHierro) > 0)
                                    {
                                        <div class="crono-barra-seg crono-barra-fe-bar" style="width:@wFe%"
                                             title="Hierro $@(CostoHierro(p.TotalHierro).ToString("N2"))"></div>
                                    }
                                </div>
                                <div class="crono-barra-costo">$@p.Costo.ToString("N0")</div>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }

    <!-- ═══ TABLA GRILLA ═════════════════════════════════════════════════════ -->
    @if (_cronogramas.Count == 0 && !_cargando)
    {
        <div class="crono-empty">
            <p>No hay datos para @NombreMes(_mes) @_anio.</p>
            <p>Haz clic en <strong>Generar / Actualizar</strong> para calcular el cronograma del mes.</p>
        </div>
    }
    else if (_cronogramas.Count > 0)
    {
        <!-- Scrollbar espejo: visible en la parte superior sin ir al pie de la tabla -->
        <div class="crono-scroll-mirror" id="cronoScrollMirror">
            <div id="cronoScrollMirrorInner"></div>
        </div>
        <div class="crono-table-wrap" id="cronoTableWrap">
            <table class="crono-table">
                <thead>
                    @* El período ya se indica en el encabezado de la página y en
                       los selectores de mes/año: la banda de título solo robaba
                       alto útil a la grilla. *@
                    <tr>
                        <th class="crono-th-fixed crono-th-paciente">Paciente</th>
                        <th class="crono-th-fixed crono-th-cedula">Cédula</th>
                        <th class="crono-th-fixed crono-th-sala">Sala</th>
                        <th class="crono-th-fixed crono-th-turno">Turno</th>
                        <th class="crono-th-fixed crono-th-dosis crono-th-epo">EPO<br/><small>UI/sem</small></th>
                        <th class="crono-th-fixed crono-th-dosis crono-th-fe">Fe IV<br/><small>mg/mes</small></th>
                        <th class="crono-th-fixed crono-th-pendiente" title="EPO que no pudo distribuirse en la primera semana parcial del cronograma">Pend.<br/><small>UI Init.</small></th>
                        @foreach (var fecha in FechasColumnaFiltradas)
                        {
                            <th class="crono-th-fecha @(EsFinDeSemana(fecha) ? "crono-fds" : "") @(EsHoy(fecha) ? "crono-hoy-th" : "") @(EsInicioSemana(fecha) ? "crono-semana-inicio" : "")">
                                <div class="crono-fecha-dia">@fecha.ToString("ddd", _es).ToUpper()</div>
                                <div class="crono-fecha-num">@fecha.Day</div>
                            </th>
                        }
                        <th class="crono-th-total">EPO<br/>Total UI</th>
                        <th class="crono-th-total">Fe IV<br/>Total mg</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var crono in CronogramasVisibles)
                    {
                        var diasMap = crono.Dias.ToDictionary(d => d.FechaSesion.Date);
                        var diasFiltrados = (TieneFiltroFecha
                            ? crono.Dias.Where(d => FechaEnRango(d.FechaSesion))
                            : _filtroDia == 0
                                ? crono.Dias
                                : crono.Dias.Where(d => (int)d.FechaSesion.DayOfWeek == _filtroDia))
                            .ToList();
                        decimal totalEpo = diasFiltrados.Sum(d => d.EpoDosisuI ?? 0);
                        decimal totalHierro = diasFiltrados.Sum(d => d.HierroDosismg ?? 0);
                        decimal epoRowCosto = diasFiltrados.Sum(d => PrecioAplicacionEpo(d.EpoDosisuI));
                        // Solo sumar pendiente al total del row si ya fue marcada Aplicada
                        bool vistaCompleta = !TieneFiltroFecha && _filtroDia == 0;
                        if (vistaCompleta && crono.EpoDosisPendienteUI > 0 &&
                            _eventosPendientes.TryGetValue(crono.Id, out var evRow) &&
                            evRow.Estado == EstadoDosisPendiente.Aplicada)
                        {
                            totalEpo    += crono.EpoDosisPendienteUI!.Value;
                            epoRowCosto += CostoPendienteEpo(crono);
                        }
                        <tr class="crono-row @(crono.Ausente ? "crono-row-ausente" : "")">
                            <td class="crono-td-fixed crono-td-paciente">
                                @PacienteDisplay.Mask(crono.Paciente.NombreCompleto)
                            </td>
                            <td class="crono-td-fixed crono-td-cedula">
                                @crono.Paciente.Identificacion
                            </td>
                            <td class="crono-td-fixed crono-td-sala">
                                <select class="crono-sala-select"
                                        value="@(crono.Sala ?? "")"
                                        @onchange="e => GuardarSalaAsync(crono.Id, e.Value?.ToString())"
                                        disabled="@(_cargandoSala.Contains(crono.Id))">
                                    <option value="">—</option>
                                    @foreach (var s in _salasOpciones.Skip(1))
                                    {
                                        <option value="@s">@s</option>
                                    }
                                </select>
                            </td>
                            <td class="crono-td-fixed crono-td-turno">
                                @if (_editTurnoId == crono.Id)
                                {
                                    <div class="crono-turno-edit">
                                        @* Select y no texto libre: el cronograma solo reconoce
                                           LMV y MJS, y cualquier otro valor deja al paciente
                                           sin días de sesión sin explicar por qué. *@
                                        <select class="crono-input-turno" @bind="_editTurnoValor">
                                            <option value="">— Sin turno —</option>
                                            <option value="LMV">LMV</option>
                                            <option value="MJS">MJS</option>
                                        </select>
                                        <div class="crono-cell-edit-btns">
                                            <button class="crono-btn-ok" @onclick="() => GuardarTurnoAsync(crono.Id)">✓</button>
                                            <button class="crono-btn-cancel" @onclick="CancelarEditTurno">✕</button>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    @if (crono.Ausente)
                                    {
                                        <span class="crono-badge-ausente">AUSENTE</span>
                                        <button class="crono-btn-ausente crono-btn-ausente-on"
                                                @onclick="() => ToggleAusenteAsync(crono.Id, false)"
                                                disabled="@(_cargandoAusente.Contains(crono.Id))"
                                                title="Reactivar paciente">
                                            Reactivar
                                        </button>
                                    }
                                    else
                                    {
                                        <span class="crono-badge-turno crono-badge-turno-edit"
                                              @onclick="() => IniciarEditTurno(crono.Id, crono.PlanSalud)"
                                              title="Click para editar turno">
                                            @(crono.PlanSalud ?? "—")
                                        </span>
                                        @if (_mapaHb.TryGetValue(crono.PacienteId, out var hbVal) && hbVal.HasValue)
                                        {
                                            <div class="crono-hb-mini @HbMiniClass(hbVal.Value)"
                                                 title="Hemoglobina: @hbVal.Value.ToString("F1") g/dL">
                                                Hb @hbVal.Value.ToString("F1")
                                            </div>
                                        }
                                        <button class="crono-btn-ausente"
                                                @onclick="() => ToggleAusenteAsync(crono.Id, true)"
                                                disabled="@(_cargandoAusente.Contains(crono.Id))"
                                                title="Marcar como ausente este mes">
                                            Ausente
                                        </button>
                                    }
                                }
                            </td>
                            <td class="crono-td-fixed crono-td-dosis crono-td-epo">
                                @(crono.EpoUiSemana?.ToString("N0") ?? "—")
                            </td>
                            <td class="crono-td-fixed crono-td-dosis crono-td-fe">
                                @(crono.HierroMgMes?.ToString("N0") ?? "—")
                            </td>
                            <td class="crono-td-fixed crono-td-pendiente">
                                @if (crono.EpoDosisPendienteUI > 0)
                                {
                                    _eventosPendientes.TryGetValue(crono.Id, out var evPend);
                                    bool aplicada = evPend?.Estado == EstadoDosisPendiente.Aplicada;
                                    <span class="crono-badge-pendiente @(aplicada ? "crono-badge-pendiente-aplicada" : "")">
                                        @crono.EpoDosisPendienteUI!.Value.ToString("N0")
                                    </span>
                                    @if (evPend != null)
                                    {
                                        <div class="crono-pend-fecha">@evPend.FechaProgramada.ToString("dd/MM")</div>
                                        <button class="crono-btn-marcar-aplicada @(aplicada ? "crono-btn-ma-on" : "")"
                                                title="@(aplicada ? "Aplicada — click para desmarcar" : "Marcar como aplicada")"
                                                disabled="@(_cargandoEvento.Contains(crono.Id))"
                                                @onclick="() => ToggleAplicadaAsync(crono.Id, evPend.Id, aplicada)">
                                            @(aplicada ? "✓ Aplicada" : "Aplicar")
                                        </button>
                                    }
                                }
                                else { <span class="crono-dash">—</span> }
                            </td>
                            @foreach (var fecha in FechasColumnaFiltradas)
                            {
                                var dia = diasMap.TryGetValue(fecha.Date, out var d) ? d : null;
                                var editKey = (crono.Id, fecha);
                                bool editando = _editKey == editKey;
                                <td class="crono-td-sesion @(dia != null ? "crono-td-activo" : "crono-td-vacio") @(dia?.EpoEditadoManual == true || dia?.HierroEditadoManual == true ? "crono-td-manual" : "") @(EsHoy(fecha) ? "crono-hoy-celda" : "") @(EsInicioSemana(fecha) ? "crono-semana-inicio" : "")">
                                    @if (dia != null)
                                    {
                                        @if (editando)
                                        {
                                            <div class="crono-cell-edit">
                                                @if (dia.EpoDosisuI.HasValue || crono.EpoUiSemana.HasValue)
                                                {
                                                    <input type="number" class="crono-input-inline" step="100"
                                                           value="@_editEpo"
                                                           @oninput="e => _editEpo = ParseDecimal(e.Value?.ToString())"
                                                           placeholder="EPO UI" />
                                                }
                                                @if (dia.HierroDosismg.HasValue || crono.HierroMgMes.HasValue)
                                                {
                                                    <input type="number" class="crono-input-inline" step="50"
                                                           value="@_editHierro"
                                                           @oninput="e => _editHierro = ParseDecimal(e.Value?.ToString())"
                                                           placeholder="Fe mg" />
                                                }
                                                <div class="crono-cell-edit-btns">
                                                    <button class="crono-btn-ok" @onclick="() => GuardarEditAsync(crono.Id, dia.Id, dia)">✓</button>
                                                    <button class="crono-btn-cancel" @onclick="CancelarEdit">✕</button>
                                                </div>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="crono-cell-val" @onclick="() => IniciarEdit(editKey, dia)">
                                                @if (dia.EpoDosisuI.HasValue)
                                                {
                                                    <span class="crono-val-epo">@dia.EpoDosisuI.Value.ToString("N0")</span>
                                                }
                                                @if (dia.HierroDosismg.HasValue && dia.HierroDosismg > 0)
                                                {
                                                    <span class="crono-val-fe-iv" title="Hierro IV — @dia.HierroDosismg.Value.ToString("N0") mg">
                                                        @dia.HierroDosismg.Value.ToString("N0")<br/><small>Fe IV</small>
                                                    </span>
                                                }
                                                @if (dia.EpoEditadoManual || dia.HierroEditadoManual)
                                                {
                                                    <span class="crono-manual-mark" title="Editado manualmente">✎</span>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="crono-dash">·</span>
                                    }
                                </td>
                            }
                            <td class="crono-td-total crono-td-total-epo">
                                @if (totalEpo > 0)
                                {
                                    <div class="crono-total-num">@totalEpo.ToString("N0")</div>
                                    @if (epoRowCosto > 0)
                                    {
                                        <div class="crono-total-costo">$@(epoRowCosto.ToString("N0"))</div>
                                    }
                                }
                                else { <span class="crono-dash">—</span> }
                            </td>
                            <td class="crono-td-total crono-td-total-fe">
                                @if (totalHierro > 0)
                                {
                                    <div class="crono-total-num">@totalHierro.ToString("N0")</div>
                                    @if (_precioHierro > 0)
                                    {
                                        <div class="crono-total-costo">$@(CostoHierro(totalHierro).ToString("N2"))</div>
                                    }
                                }
                                else { <span class="crono-dash">—</span> }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</div>

@code {
    private int _anio = DateTime.Today.Year;
    private int _mes = DateTime.Today.Month;
    private bool _cargando = false;
    private bool _showConfig = false;

    // RF3: Modo de cronograma
    private short    _modo = 0;
    private DateTime _fechaInicioFlex = DateTime.Today;

    private Guid _tenantId;
    private string _busqueda = "";
    private bool _needScrollSync = false;
    private List<CronogramaMedicamento> _cronogramas = new();
    private List<DateTime> _fechasColumna = new();

    // Filtros de segmento
    private string    _filtroTurno      = "Todos";
    private int       _filtroDia        = 0;   // 0=Todos; 1=Lun…6=Sáb  (alineado con DayOfWeek)
    private string    _filtroSala       = "Todas";
    private DateTime? _filtroFechaDesde = null;
    private DateTime? _filtroFechaHasta = null;

    private bool TieneFiltroFecha => _filtroFechaDesde.HasValue || _filtroFechaHasta.HasValue;
    private bool FechaEnRango(DateTime fecha)
    {
        var d = fecha.Date;
        if (_filtroFechaDesde.HasValue && d < _filtroFechaDesde.Value.Date) return false;
        if (_filtroFechaHasta.HasValue && d > _filtroFechaHasta.Value.Date) return false;
        return true;
    }
    private static readonly (string Label, int Val)[] _diasFiltroOpciones =
    {
        ("Todos", 0), ("Lun", 1), ("Mar", 2), ("Mié", 3),
        ("Jue", 4), ("Vie", 5), ("Sáb", 6)
    };
    private static readonly string[] _salasOpciones =
        { "Todas", "Sala 1", "Sala 2", "Sala 3", "Sala 4", "Sala 5", "Sala 6", "Sala 7" };

    // RF2: Sala — carga en progreso
    private HashSet<Guid> _cargandoSala = new();

    // Edición inline de turno
    private Guid?  _editTurnoId;
    private string _editTurnoValor = "";

    // Gráficos
    private bool _showGraficos = false;
    private record CostoPaciente(string Nombre, string Cedula, decimal TotalEpo, decimal TotalHierro, decimal EpoCosto, decimal Costo);
    private record ResumenDosisAdmRow(decimal DosisUI, int Aplicaciones, decimal TotalUI, decimal Precio, decimal Costo);

    private IEnumerable<CostoPaciente> Top20Pacientes =>
        _cronogramas
            .Select(c =>
            {
                bool evAplic = _eventosPendientes.TryGetValue(c.Id, out var evT) &&
                               evT.Estado == EstadoDosisPendiente.Aplicada;
                var epo = c.Dias.Sum(d => d.EpoDosisuI ?? 0) +
                          (evAplic ? (c.EpoDosisPendienteUI ?? 0) : 0);
                var fe  = c.Dias.Sum(d => d.HierroDosismg ?? 0);
                var epoCosto = c.Dias.Sum(d => PrecioAplicacionEpo(d.EpoDosisuI))
                    + (evAplic ? CostoPendienteEpo(c) : 0);
                return new CostoPaciente(
                    c.Paciente.NombreCompleto,
                    c.Paciente.Identificacion,
                    epo, fe, epoCosto,
                    epoCosto + CostoHierro(fe));
            })
            .Where(p => p.Costo > 0)
            .OrderByDescending(p => p.Costo)
            .Take(20);

    private IEnumerable<CronogramaMedicamento> CronogramasVisibles =>
        _cronogramas
            .Where(c => string.IsNullOrWhiteSpace(_busqueda) ||
                c.Paciente.Identificacion.Contains(_busqueda, StringComparison.OrdinalIgnoreCase) ||
                c.Paciente.NombreCompleto.Contains(_busqueda, StringComparison.OrdinalIgnoreCase))
            .Where(c => _filtroTurno == "Todos" ||
                (!string.IsNullOrWhiteSpace(c.PlanSalud) &&
                 c.PlanSalud.ToUpperInvariant().Contains(_filtroTurno)))
            .Where(c => TieneFiltroFecha
                ? c.Dias.Any(d => FechaEnRango(d.FechaSesion))
                : _filtroDia == 0 || c.Dias.Any(d => (int)d.FechaSesion.DayOfWeek == _filtroDia))
            .Where(c => _filtroSala == "Todas" ||
                string.Equals(c.Sala, _filtroSala, StringComparison.OrdinalIgnoreCase));

    // RF3: computed
    private DateTime FechaFinFlex => _fechaInicioFlex.AddMonths(1).AddDays(-1);
    private string SubtituloModo => _modo == 0
        ? $"{NombreMes(_mes)} {_anio}"
        : $"Flexible {_fechaInicioFlex:dd/MM/yy} – {FechaFinFlex:dd/MM/yy}";

    // Columnas visibles según el filtro de fecha o día activo
    private IReadOnlyList<DateTime> FechasColumnaFiltradas =>
        TieneFiltroFecha
            ? _fechasColumna.Where(f => FechaEnRango(f)).ToList()
            : _filtroDia == 0
                ? _fechasColumna
                : _fechasColumna.Where(f => (int)f.DayOfWeek == _filtroDia).ToList();

    // RF1: resumen + desglose administrado + desglose pendiente (no administrado) — un solo recorrido O(n)
    private (ResumenCostos? resumen, List<ResumenDosisAdmRow> desglose, List<ResumenDosisAdmRow> desglPend) ComputarResumenYDesglose()
    {
        var visible = CronogramasVisibles.ToList();
        if (visible.Count == 0) return (null, new(), new());

        var aplsPorDosis  = new Dictionary<decimal, (int Apps, decimal TotalUI, decimal Costo)>();
        var pendPorDosis  = new Dictionary<decimal, (int Pacientes, decimal TotalUI, decimal Costo)>();
        int totalSesiones = 0;
        decimal totalEpoUI = 0, totalHierroMg = 0, costoEpo = 0, costoHierro = 0;

        bool resumenCompleto = !TieneFiltroFecha && _filtroDia == 0;
        foreach (var crono in visible)
        {
            IEnumerable<CronogramaDia> dias = TieneFiltroFecha
                ? crono.Dias.Where(d => FechaEnRango(d.FechaSesion))
                : _filtroDia == 0
                    ? crono.Dias
                    : crono.Dias.Where(d => (int)d.FechaSesion.DayOfWeek == _filtroDia);
            foreach (var dia in dias)
            {
                totalSesiones++;
                var epoUI = dia.EpoDosisuI ?? 0;
                var feUI  = dia.HierroDosismg ?? 0;
                totalEpoUI    += epoUI;
                totalHierroMg += feUI;
                if (epoUI > 0)
                {
                    // Una sesión = una aplicación: cuesta el precio completo de la dosis
                    var precio = _preciosEpo.GetValueOrDefault(epoUI, 0);
                    costoEpo += precio;
                    if (!aplsPorDosis.TryGetValue(epoUI, out var acc))
                        acc = (0, 0, 0);
                    aplsPorDosis[epoUI] = (acc.Apps + 1, acc.TotalUI + epoUI, acc.Costo + precio);
                }
                costoHierro += CostoHierro(feUI);
            }

            // Dosis inicial pendiente: administrada solo si fue marcada Aplicada; sino va a pendPorDosis
            if (resumenCompleto && crono.EpoDosisPendienteUI > 0 && crono.EpoUiSemana > 0)
            {
                var pendUI      = crono.EpoDosisPendienteUI!.Value;
                var dosisSesion = DosisPorSesionEpo(crono.EpoUiSemana!.Value);
                if (dosisSesion > 0)
                {
                    bool evAplic = _eventosPendientes.TryGetValue(crono.Id, out var evC) &&
                                   evC.Estado == EstadoDosisPendiente.Aplicada;
                    var sesEq     = (int)Math.Round(pendUI / dosisSesion);
                    var precio    = _preciosEpo.GetValueOrDefault(dosisSesion, 0);
                    var costoPend = sesEq * precio;

                    if (evAplic)
                    {
                        totalEpoUI += pendUI;
                        costoEpo   += costoPend;
                        if (!aplsPorDosis.TryGetValue(dosisSesion, out var acc))
                            acc = (0, 0, 0);
                        aplsPorDosis[dosisSesion] = (acc.Apps + sesEq, acc.TotalUI + pendUI, acc.Costo + costoPend);
                    }
                    else
                    {
                        if (!pendPorDosis.TryGetValue(dosisSesion, out var pacc))
                            pacc = (0, 0, 0);
                        pendPorDosis[dosisSesion] = (pacc.Pacientes + 1, pacc.TotalUI + pendUI, pacc.Costo + costoPend);
                    }
                }
            }
        }

        var resumen = new ResumenCostos
        {
            TotalPacientes = visible.Count,
            TotalSesiones  = totalSesiones,
            TotalEpoUI     = totalEpoUI,
            TotalHierroMg  = totalHierroMg,
            CostoEpo       = costoEpo,
            CostoHierro    = costoHierro
        };

        var desglose = aplsPorDosis
            .OrderBy(kv => kv.Key)
            .Select(kv => new ResumenDosisAdmRow(
                kv.Key, kv.Value.Apps, kv.Value.TotalUI,
                _preciosEpo.GetValueOrDefault(kv.Key, 0), kv.Value.Costo))
            .ToList();

        var desglPend = pendPorDosis
            .OrderBy(kv => kv.Key)
            .Select(kv => new ResumenDosisAdmRow(
                kv.Key, kv.Value.Pacientes, kv.Value.TotalUI,
                _preciosEpo.GetValueOrDefault(kv.Key, 0), kv.Value.Costo))
            .ToList();

        return (resumen, desglose, desglPend);
    }

    private List<PrecioEpoDosis> _dosisEpoConfig = new();
    private Dictionary<decimal, decimal> _preciosEpo = new();
    private decimal _precioHierro = 0;

    // Dosis UI que se asigna en cada sesión según la prescripción semanal
    private static decimal DosisPorSesionEpo(decimal epoUiSemana) =>
        (int)Math.Round(epoUiSemana) switch
        {
            2000  => 2000m,
            4000  => 2000m,
            6000  => 2000m,
            8000  => 4000m,
            12000 => 4000m,
            18000 => 6000m,
            _     => 0m
        };

    /// <summary>
    /// Costo del hierro IV según el precio por ampolla configurado.
    /// La regla vive en <see cref="CostoMedicacion"/> para que la pantalla y el
    /// servicio no puedan divergir.
    /// </summary>
    private decimal CostoHierro(decimal mg) => CostoMedicacion.CostoHierro(mg, _precioHierro);

    /// <summary>
    /// Costo de UNA aplicación de EPO. El precio configurado es por dosis
    /// administrada (ej. 2,000 UI = $2.80 por aplicación), no por unidad
    /// internacional, así que no se multiplica por las UI.
    /// </summary>
    private decimal PrecioAplicacionEpo(decimal? dosisUI)
    {
        var d = dosisUI ?? 0;
        return d > 0 ? _preciosEpo.GetValueOrDefault(d, 0) : 0;
    }

    private decimal CostoPendienteEpo(CronogramaMedicamento crono)
    {
        var pendiente = crono.EpoDosisPendienteUI ?? 0;
        if (pendiente <= 0 || !(crono.EpoUiSemana > 0)) return 0;
        var dosisSesion = DosisPorSesionEpo(crono.EpoUiSemana!.Value);
        if (dosisSesion <= 0) return 0;
        return (pendiente / dosisSesion) * _preciosEpo.GetValueOrDefault(dosisSesion, 0);
    }

    private (Guid CronogramaId, DateTime Fecha)? _editKey;
    private decimal? _editEpo;
    private decimal? _editHierro;

    // Eventos de dosis pendiente (Fase 2), indexados por CronogramaId
    private Dictionary<Guid, EventoDosisPendiente> _eventosPendientes = new();
    private HashSet<Guid> _cargandoEvento = new();

    // Hb del último snapshot mensual, indexado por PacienteId
    private Dictionary<Guid, decimal?> _mapaHb = new();

    // Cronogramas con toggle ausente en progreso
    private HashSet<Guid> _cargandoAusente = new();

    // ── Paneles de resumen colapsables ────────────────────────────────────────
    // Se recuerda la preferencia del usuario en localStorage para que no tenga
    // que volver a colapsar los paneles en cada visita.
    private const string PrefResumenEpo   = "dm.crono.resumenEpo";
    private const string PrefEpoPendiente = "dm.crono.epoPendiente";

    private bool _showResumenEpo   = true;
    private bool _showEpoPendiente = true;
    private bool _prefsCargadas;

    /// <summary>Modal con el resumen de costos y los desgloses de EPO.</summary>
    private bool _showResumen;

    private async Task ToggleResumenEpoAsync()
    {
        _showResumenEpo = !_showResumenEpo;
        await GuardarPrefAsync(PrefResumenEpo, _showResumenEpo);
    }

    private async Task ToggleEpoPendienteAsync()
    {
        _showEpoPendiente = !_showEpoPendiente;
        await GuardarPrefAsync(PrefEpoPendiente, _showEpoPendiente);
    }

    private async Task GuardarPrefAsync(string clave, bool valor)
    {
        try { await JS.InvokeVoidAsync("dmPrefs.setBool", clave, valor); }
        catch (JSException) { /* localStorage bloqueado: el toggle sigue funcionando en sesión */ }
    }

    private static readonly System.Globalization.CultureInfo _es =
        new System.Globalization.CultureInfo("es-ES");

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        var tenantStr = auth.User.FindFirst("tenant_id")?.Value;
        _tenantId = Guid.TryParse(tenantStr, out var t) ? t : Guid.Empty;

        await CargarConfiguracionAsync();
        await CargarCronogramasAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_prefsCargadas)
        {
            _prefsCargadas = true;
            try
            {
                _showResumenEpo   = await JS.InvokeAsync<bool>("dmPrefs.getBool", PrefResumenEpo,   true);
                _showEpoPendiente = await JS.InvokeAsync<bool>("dmPrefs.getBool", PrefEpoPendiente, true);
                StateHasChanged();
            }
            catch (JSException) { /* sin localStorage: se mantienen los paneles expandidos */ }
        }

        if (_needScrollSync)
        {
            _needScrollSync = false;
            await JS.InvokeVoidAsync("initCronoScrollSync");
        }
    }

    private async Task CargarConfiguracionAsync()
    {
        var configs = await ConfigRepo.GetByTenantAsync(_tenantId);
        _precioHierro = configs.FirstOrDefault(c => c.Medicamento == "HIERRO")?.PrecioUnitario ?? 0;

        _dosisEpoConfig = await PrecioEpoDosisRepo.GetByTenantAsync(_tenantId);
        if (_dosisEpoConfig.Count == 0)
        {
            _dosisEpoConfig = new List<PrecioEpoDosis>
            {
                new() { TenantId = _tenantId, DosisUI = 2000, Precio = 0 },
                new() { TenantId = _tenantId, DosisUI = 4000, Precio = 0 },
                new() { TenantId = _tenantId, DosisUI = 6000, Precio = 0 },
            };
        }
        _preciosEpo = _dosisEpoConfig.ToDictionary(p => p.DosisUI, p => p.Precio);
    }

    private async Task CargarCronogramasAsync()
    {
        _cronogramas = await CronogramaService.GetCronogramasMesAsync(_tenantId, _anio, _mes);
        _fechasColumna = ObtenerFechasColumna();
        if (_cronogramas.Count > 0)
            _needScrollSync = true;
        var eventos = await EventoRepo.GetByPeriodoAsync(_tenantId, _anio, _mes);
        _eventosPendientes = eventos.ToDictionary(e => e.CronogramaId);
        await CargarHbAsync();
    }

    private async Task CargarHbAsync()
    {
        try
        {
            var snapshots = await SnapshotRepo.GetByPeriodoAsync(
                _tenantId, new DateTime(_anio, _mes, 1), tamano: 1000);
            _mapaHb = snapshots
                .GroupBy(s => s.PacienteId)
                .ToDictionary(g => g.Key, g => g.First().HbValor);
        }
        catch { _mapaHb = new(); }
    }

    private async Task GenerarCronogramaAsync()
    {
        _cargando = true;
        StateHasChanged();
        try
        {
            Loading.Show("Generando cronograma...");
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Guid? usuarioId = null;
            if (Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid))
                usuarioId = uid;

            _cronogramas = await CronogramaService.GenerarOActualizarMesAsync(
                _tenantId, _anio, _mes, usuarioId,
                _modo == 1 ? _fechaInicioFlex : null);
            _fechasColumna = ObtenerFechasColumna();
            _needScrollSync = true;
            await CargarHbAsync();
            Toast.ShowSuccess($"Cronograma de {NombreMes(_mes)} {_anio} actualizado — {_cronogramas.Count} pacientes");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al generar cronograma: {ex.Message}");
        }
        finally
        {
            Loading.Hide();
            _cargando = false;
        }
    }

    private async Task GuardarPreciosAsync()
    {
        try
        {
            await PrecioEpoDosisRepo.UpsertManyAsync(_dosisEpoConfig);
            _preciosEpo = _dosisEpoConfig.ToDictionary(p => p.DosisUI, p => p.Precio);

            await ConfigRepo.UpsertAsync(new ConfiguracionMedicamento
            {
                TenantId = _tenantId,
                Medicamento = "HIERRO",
                PrecioUnitario = _precioHierro,
                Unidad = "mg"
            });
            _showConfig = false;
            Toast.ShowSuccess("Precios guardados correctamente");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al guardar precios: {ex.Message}");
        }
    }

    private void IniciarEdit((Guid, DateTime) key, CronogramaDia dia)
    {
        _editKey = key;
        _editEpo = dia.EpoDosisuI;
        _editHierro = dia.HierroDosismg;
    }

    private void CancelarEdit()
    {
        _editKey = null;
        _editEpo = null;
        _editHierro = null;
    }

    private async Task GuardarEditAsync(Guid cronogramaId, Guid diaId, CronogramaDia diaActual)
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            if (!Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var usuarioId))
                usuarioId = Guid.Empty;

            await CronogramaService.EditarDiaAsync(
                _tenantId, cronogramaId, diaId,
                _editEpo, _editHierro,
                diaActual.EpoDosisuI, diaActual.HierroDosismg,
                null, usuarioId);

            CancelarEdit();
            await CargarCronogramasAsync();
            Toast.ShowSuccess("Dosis actualizada");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al guardar: {ex.Message}");
        }
    }

    private async Task ExportarExcelAsync()
    {
        try
        {
            Loading.Show("Exportando...");
            var bytes = GenerarExcelBytes();
            var base64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("downloadFileFromBase64",
                $"cronograma_{_anio}_{_mes:D2}.xlsx",
                base64,
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
            Toast.ShowSuccess("Archivo descargado");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al exportar: {ex.Message}");
        }
        finally
        {
            Loading.Hide();
        }
    }

    private byte[] GenerarExcelBytes()
    {
        using var ms = new System.IO.MemoryStream();
        using var wb = new ClosedXML.Excel.XLWorkbook();
        var ws = wb.Worksheets.Add("Cronograma");

        var (rv, _, _) = ComputarResumenYDesglose();
        var fechas = FechasColumnaFiltradas;

        // ── Fila 1: Título ────────────────────────────────────────────────────
        ws.Cell(1, 1).Value = $"CRONOGRAMA DE MEDICACIÓN — {SubtituloModo.ToUpper()}";
        ws.Range(1, 1, 1, 10).Merge();
        ws.Row(1).Style.Font.Bold = true;
        ws.Row(1).Style.Font.FontSize = 13;
        ws.Row(1).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromHtml("#125e8a");
        ws.Row(1).Style.Font.FontColor = ClosedXML.Excel.XLColor.White;

        // ── Fila 2: Resumen ───────────────────────────────────────────────────
        int rc = 1;
        void RLabel(string t) { ws.Cell(2, rc).Value = t;   ws.Cell(2, rc).Style.Font.Bold = true; ws.Cell(2, rc).Style.Font.FontColor = ClosedXML.Excel.XLColor.FromHtml("#64748b"); rc++; }
        void RValue(object v) { ws.Cell(3, rc - 1).Value = v.ToString(); ws.Cell(3, rc - 1).Style.Font.Bold = true; }

        RLabel("PACIENTES");  RValue(rv?.TotalPacientes ?? 0);
        RLabel("SESIONES");   RValue(rv?.TotalSesiones ?? 0);
        RLabel("TOTAL EPO (UI)"); RValue(rv?.TotalEpoUI.ToString("N0") ?? "—");
        RLabel("TOTAL HIERRO (mg)"); RValue(rv?.TotalHierroMg.ToString("N0") ?? "—");
        if (_preciosEpo.Values.Any(v => v > 0) || _precioHierro > 0)
        {
            RLabel("COSTO EPO");   RValue("$ " + (rv?.CostoEpo.ToString("N2") ?? "—"));
            RLabel("COSTO HIERRO"); RValue("$ " + (rv?.CostoHierro.ToString("N2") ?? "—"));
            RLabel("TOTAL");       RValue("$ " + (rv?.CostoTotal.ToString("N2") ?? "—"));
        }
        ws.Row(2).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromHtml("#f1f5f9");
        ws.Row(3).Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromHtml("#f8fafc");

        // ── Fila 5: Encabezados de datos ──────────────────────────────────────
        int headerRow = 5;
        int col = 1;
        ws.Cell(headerRow, col++).Value = "Paciente";
        ws.Cell(headerRow, col++).Value = "Cédula";
        ws.Cell(headerRow, col++).Value = "Sala";
        ws.Cell(headerRow, col++).Value = "Turno";
        ws.Cell(headerRow, col++).Value = "EPO UI/sem";
        ws.Cell(headerRow, col++).Value = "Hierro mg/mes";
        ws.Cell(headerRow, col++).Value = "Pend. EPO UI";
        foreach (var f in fechas)
            ws.Cell(headerRow, col++).Value = f.ToString("dd/MM ddd", _es);
        ws.Cell(headerRow, col++).Value = "Total EPO UI";
        ws.Cell(headerRow, col).Value   = "Total Hierro mg";

        var hdr = ws.Row(headerRow);
        hdr.Style.Font.Bold = true;
        hdr.Style.Fill.BackgroundColor = ClosedXML.Excel.XLColor.FromHtml("#125e8a");
        hdr.Style.Font.FontColor = ClosedXML.Excel.XLColor.White;

        // ── Filas de datos ────────────────────────────────────────────────────
        int row = headerRow + 1;
        foreach (var crono in CronogramasVisibles)
        {
            var diasMap = crono.Dias.ToDictionary(d => d.FechaSesion.Date);
            col = 1;
            ws.Cell(row, col++).Value = crono.Paciente.NombreCompleto;
            ws.Cell(row, col++).Value = crono.Paciente.Identificacion;
            ws.Cell(row, col++).Value = crono.Sala ?? "";
            ws.Cell(row, col++).Value = crono.PlanSalud ?? "";
            ws.Cell(row, col++).Value = (double?)crono.EpoUiSemana ?? 0;
            ws.Cell(row, col++).Value = (double?)crono.HierroMgMes ?? 0;
            ws.Cell(row, col++).Value = (double?)crono.EpoDosisPendienteUI ?? 0;
            foreach (var f in fechas)
            {
                if (diasMap.TryGetValue(f.Date, out var d))
                {
                    var val = "";
                    if (d.EpoDosisuI.HasValue) val += d.EpoDosisuI.Value.ToString("N0");
                    if (d.HierroDosismg.HasValue) val += (val.Length > 0 ? " / Fe" : "Fe") + d.HierroDosismg.Value.ToString("N0");
                    ws.Cell(row, col++).Value = val;
                }
                else col++;
            }
            // Totales de fila: mismo filtro que la vista (rango de fechas, día específico o todo)
            var diasXls = (TieneFiltroFecha
                ? crono.Dias.Where(d => FechaEnRango(d.FechaSesion))
                : _filtroDia == 0
                    ? crono.Dias
                    : crono.Dias.Where(d => (int)d.FechaSesion.DayOfWeek == _filtroDia)).ToList();
            decimal totEpo    = diasXls.Sum(d => d.EpoDosisuI    ?? 0);
            decimal totHierro = diasXls.Sum(d => d.HierroDosismg ?? 0);
            ws.Cell(row, col++).Value = (double)totEpo;
            ws.Cell(row, col).Value   = (double)totHierro;
            row++;
        }

        ws.Columns().AdjustToContents();
        wb.SaveAs(ms);
        return ms.ToArray();
    }

    private List<DateTime> ObtenerFechasColumna()
    {
        if (_cronogramas.Count == 0) return new List<DateTime>();
        return _cronogramas
            .SelectMany(c => c.Dias.Select(d => d.FechaSesion.Date))
            .Distinct()
            .OrderBy(f => f)
            .ToList();
    }

    private static string NombreMes(int mes) => mes switch
    {
        1 => "Enero", 2 => "Febrero", 3 => "Marzo", 4 => "Abril",
        5 => "Mayo", 6 => "Junio", 7 => "Julio", 8 => "Agosto",
        9 => "Septiembre", 10 => "Octubre", 11 => "Noviembre", 12 => "Diciembre",
        _ => mes.ToString()
    };

    private static bool EsFinDeSemana(DateTime d) =>
        d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday;

    private static bool EsHoy(DateTime d) => d.Date == DateTime.Today;

    private bool EsInicioSemana(DateTime fecha)
    {
        var idx = _fechasColumna.IndexOf(fecha);
        if (idx <= 0) return false;
        return System.Globalization.ISOWeek.GetWeekOfYear(_fechasColumna[idx - 1]) !=
               System.Globalization.ISOWeek.GetWeekOfYear(fecha);
    }

    private void IniciarEditTurno(Guid cronogramaId, string? planSalud)
    {
        _editTurnoId    = cronogramaId;
        _editTurnoValor = planSalud ?? "";
    }

    private void CancelarEditTurno()
    {
        _editTurnoId    = null;
        _editTurnoValor = "";
    }

    private async Task GuardarTurnoAsync(Guid cronogramaId)
    {
        try
        {
            Loading.Show("Actualizando turno y regenerando...");
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Guid? usuarioId = null;
            if (Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid))
                usuarioId = uid;

            var actualizado = await CronogramaService.ActualizarTurnoYRegenerarAsync(
                _tenantId, cronogramaId, _editTurnoValor, usuarioId);

            var idx = _cronogramas.FindIndex(c => c.Id == cronogramaId);
            if (idx >= 0) _cronogramas[idx] = actualizado;
            _fechasColumna  = ObtenerFechasColumna();
            _needScrollSync = true;

            CancelarEditTurno();
            Toast.ShowSuccess("Turno actualizado y cronograma regenerado");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al actualizar turno: {ex.Message}");
        }
        finally
        {
            Loading.Hide();
        }
    }

    private async Task ToggleAusenteAsync(Guid cronogramaId, bool nuevoEstado)
    {
        _cargandoAusente.Add(cronogramaId);
        StateHasChanged();
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Guid? usuarioId = null;
            if (Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid))
                usuarioId = uid;

            var actualizado = await CronogramaService.MarcarAusenteAsync(
                _tenantId, cronogramaId, nuevoEstado, usuarioId);

            if (nuevoEstado)
            {
                // Ausente: reemplazar la fila; ResumenVisible recalcula automáticamente
                var idx = _cronogramas.FindIndex(c => c.Id == cronogramaId);
                if (idx >= 0) _cronogramas[idx] = actualizado;
                _fechasColumna = ObtenerFechasColumna();
            }
            else
            {
                // Reactivado con días regenerados: recargar todo para reflejar nuevas fechas
                _cronogramas = await CronogramaService.GetCronogramasMesAsync(_tenantId, _anio, _mes);
                _fechasColumna = ObtenerFechasColumna();
                await CargarHbAsync();
            }
            _needScrollSync = true;

            Toast.ShowSuccess(nuevoEstado ? "Paciente marcado como AUSENTE — días eliminados del cronograma" : "Paciente reactivado — cronograma regenerado");
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error: {ex.Message}");
        }
        finally
        {
            _cargandoAusente.Remove(cronogramaId);
        }
    }

    private async Task ToggleAplicadaAsync(Guid cronogramaId, Guid eventoId, bool estabaAplicada)
    {
        _cargandoEvento.Add(cronogramaId);
        StateHasChanged();
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Guid? usuarioId = null;
            if (Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid))
                usuarioId = uid;

            var nuevoEstado = estabaAplicada
                ? EstadoDosisPendiente.Programada
                : EstadoDosisPendiente.Aplicada;

            await EventoRepo.ActualizarEstadoAsync(eventoId, nuevoEstado, usuarioId);

            // Actualizar el mapa local sin recargar todo
            if (_eventosPendientes.TryGetValue(cronogramaId, out var ev))
                ev.Estado = nuevoEstado;
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al actualizar estado: {ex.Message}");
        }
        finally
        {
            _cargandoEvento.Remove(cronogramaId);
        }
    }

    private static string HbMiniClass(decimal v) => v switch
    {
        < 8m    => "crono-hb-crit",
        < 10m   => "crono-hb-baja",
        <= 12m  => "crono-hb-ok",
        _       => "crono-hb-alta"
    };

    private static string TruncateNombre(string nombre, int maxLen) =>
        nombre.Length <= maxLen ? nombre : nombre[..maxLen] + "…";

    private async Task GuardarSalaAsync(Guid cronogramaId, string? sala)
    {
        _cargandoSala.Add(cronogramaId);
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            Guid? usuarioId = null;
            if (Guid.TryParse(authState.User.FindFirst("sub")?.Value, out var uid))
                usuarioId = uid;
            await CronogramaService.ActualizarSalaAsync(_tenantId, cronogramaId, sala, usuarioId);
            var idx = _cronogramas.FindIndex(c => c.Id == cronogramaId);
            if (idx >= 0) _cronogramas[idx].Sala = string.IsNullOrWhiteSpace(sala) ? null : sala.Trim();
        }
        catch (Exception ex)
        {
            Toast.ShowError($"Error al guardar sala: {ex.Message}");
        }
        finally
        {
            _cargandoSala.Remove(cronogramaId);
        }
    }

