    // Los input type=number siempre envían el valor con punto decimal, sin importar
    // el idioma del navegador. Se parsea en invariante y se acepta la coma como
    // separador decimal por si el valor llega escrito o pegado a mano.
    private static decimal? ParseDecimal(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return null;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        var estilo = System.Globalization.NumberStyles.Float;

        if (decimal.TryParse(s, estilo, inv, out var v)) return v;
        return decimal.TryParse(s.Replace(',', '.'), estilo, inv, out v) ? v : null;
    }

    /// <summary>
    /// Formato monetario para campos editables: siempre punto decimal y al menos
    /// dos decimales (2.80, no 2,8000), conservando hasta cuatro si el precio los
    /// necesita para no perder precisión al reeditar.
    /// </summary>
    private static string Money(decimal v) =>
        v.ToString("0.00##", System.Globalization.CultureInfo.InvariantCulture);
}

