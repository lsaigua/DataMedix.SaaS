    .crono-config-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.82rem;
        color: #475569;
    }
    .crono-config-input {
        width: 110px;
        padding: 0.35rem 0.5rem;
        border: 1px solid #cbd5e1;
        border-radius: 6px;
        font-size: 0.82rem;
        color: #1e293b;
    }
    .crono-config-actions { display: flex; gap: 0.4rem; margin-left: auto; }

    /* EPO dosis table inside config panel */
    .crono-config-epo-section { display: flex; flex-direction: column; gap: 0.35rem; }
    .crono-config-epo-label { font-size: 0.8rem; color: #475569; font-weight: 600; }
    .crono-config-epo-table { border-collapse: collapse; font-size: 0.82rem; }
    .crono-config-epo-table th,
    .crono-config-epo-table td { padding: 0.2rem 0.6rem; text-align: left; }
    .crono-config-epo-table th { color: #64748b; font-weight: 600; border-bottom: 1px solid #e2e8f0; }
    .crono-config-epo-table td:first-child { color: #1e293b; min-width: 80px; }

    /* Campo monetario: el "$" delante evita leer 2,8000 como dos mil ochocientos */
    .crono-config-money { display: inline-flex; align-items: center; gap: 0.3rem; }
    .crono-config-money-sign { color: #64748b; font-weight: 700; font-size: 0.82rem; }
    .crono-config-money .crono-config-input { width: 92px; text-align: right; }
    .crono-config-hint {
        margin: 0.15rem 0 0;
        font-size: 0.72rem;
        color: #64748b;
        font-style: italic;
    }
    .crono-config-hint-inline { margin: 0; white-space: nowrap; }

    /* Resumen costos */
    .crono-resumen {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 0.75rem 1.25rem;
    }
    .crono-resumen-item {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
        padding: 0 0.75rem;
        border-right: 1px solid #e2e8f0;
    }
    .crono-resumen-item:last-child { border-right: none; }
    .crono-resumen-label { font-size: 0.68rem; color: #94a3b8; text-transform: uppercase; font-weight: 700; letter-spacing: 0.04em; }
    .crono-resumen-value { font-size: 1rem; font-weight: 700; color: var(--dm-brand-ink); }
    .crono-cost { color: #0ea5e9; }
    .crono-resumen-total .crono-resumen-value { color: #7c3aed; font-size: 1.1rem; }

    /* ── Botón Resumen en la barra de acciones ─────────────────────────────── */
    .crono-btn-resumen {
        background: var(--dm-brand-surface);
        color: #e2e8f0;
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
    }
    .crono-btn-resumen:hover:not(:disabled) { background: var(--dm-brand-surface-hover); }
    .crono-btn-resumen svg { width: 15px; height: 15px; flex: none; }
    .crono-btn-badge {
        background: rgba(56, 189, 248, 0.2);
        color: #7dd3fc;
        border-radius: 999px;
        padding: 0.08rem 0.45rem;
        font-size: 0.7rem;
        font-weight: 700;
        white-space: nowrap;
    }

    /* ── Modal de resumen ──────────────────────────────────────────────────── */
    .crono-resumen-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(2px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1200;
        padding: 1.5rem;
        animation: crono-fade-in 0.16s ease;
    }
    .crono-resumen-modal {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 24px 60px rgba(15, 23, 42, 0.35);
        width: 100%;
        max-width: 940px;
        max-height: 88vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        animation: crono-modal-in 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .crono-resumen-modal-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 1.1rem 1.4rem;
        border-bottom: 1px solid #e2e8f0;
        background: #f8fafc;
        flex: none;
    }
    .crono-resumen-modal-title {
        font-size: 1.05rem;
        font-weight: 800;
        color: var(--dm-brand-ink);
        margin: 0 0 0.15rem;
    }
    .crono-resumen-modal-sub { font-size: 0.78rem; color: #64748b; margin: 0; }
    .crono-resumen-modal-close {
        border: none;
        background: transparent;
        color: #94a3b8;
        font-size: 1.6rem;
        line-height: 1;
        cursor: pointer;
        padding: 0 0.25rem;
        border-radius: 8px;
        transition: all 0.15s;
    }
    .crono-resumen-modal-close:hover { background: #e2e8f0; color: var(--dm-brand-ink); }
    .crono-resumen-modal-close:focus-visible { outline: 2px solid #0ea5e9; outline-offset: 2px; }

    /* Solo el cuerpo scrollea: cabecera y pie quedan fijos */
    .crono-resumen-modal-body {
        padding: 1.1rem 1.4rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: 0.9rem;
    }
    .crono-resumen-modal-footer {
        padding: 0.8rem 1.4rem;
        border-top: 1px solid #e2e8f0;
        background: #f8fafc;
        display: flex;
        justify-content: flex-end;
        flex: none;
    }
    .crono-resumen-modal-aviso {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        border-radius: 8px;
        padding: 0.5rem 0.8rem;
        font-size: 0.76rem;
        color: #9a3412;
    }

    @@keyframes crono-fade-in { from { opacity: 0; } to { opacity: 1; } }
    @@keyframes crono-modal-in {
        from { opacity: 0; transform: translateY(12px) scale(0.985); }
        to   { opacity: 1; transform: none; }
    }
    @@media (prefers-reduced-motion: reduce) {
        .crono-resumen-overlay, .crono-resumen-modal { animation: none; }
    }

    /* Desglose EPO por dosis prescrita */
    .crono-desglose-epo {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
    }
    /* Cabecera = control de disclosure: toda la barra es clickable (área grande,
       ley de Fitts) y funciona con teclado por ser un button nativo. */
    .crono-desglose-epo-header {
        background: var(--dm-brand-surface);
        color: var(--dm-on-brand-soft);
        padding: 0.45rem 1rem;
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        width: 100%;
        border: 0;
        margin: 0;
        font-family: inherit;
        text-align: left;
        cursor: pointer;
        transition: background 0.16s ease;
    }
    .crono-desglose-epo-header:hover  { background: var(--dm-brand-surface-hover); }
    .crono-desglose-epo-header:active { background: var(--dm-brand-surface-strong); }
    .crono-desglose-epo-header:focus-visible {
        outline: 2px solid #38bdf8;
        outline-offset: -2px;
    }
    .crono-desglose-epo-titulo { color: #e2e8f0; }
    .crono-desglose-epo-sub { font-size: 0.6rem; color: var(--dm-on-brand-muted); text-transform: none; letter-spacing: 0; }

    /* Chevron: única señal de estado que rota 180° al expandir */
    .crono-desglose-chevron {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.05rem;
        height: 1.05rem;
        flex: none;
        color: #94a3b8;
        transform: rotate(0deg);
        transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .crono-desglose-chevron svg { width: 100%; height: 100%; }
    .crono-desglose-colapsado .crono-desglose-chevron { transform: rotate(-90deg); }

    /* Cifras clave en la cabecera: colapsar oculta el detalle, nunca el total */
    .crono-desglose-peek {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: 0.4rem;
        flex-wrap: wrap;
        justify-content: flex-end;
    }
    .crono-peek-chip {
        background: rgba(148, 163, 184, 0.16);
        color: #cbd5e1;
        border-radius: 999px;
        padding: 0.12rem 0.5rem;
        font-size: 0.62rem;
        font-weight: 700;
        letter-spacing: 0.03em;
        white-space: nowrap;
    }
    .crono-peek-costo { background: rgba(255, 255, 255, 0.22); color: #ffffff; }

    /* Animación de altura sin JS: grid 1fr → 0fr anima a contenido variable */
    .crono-desglose-epo-body {
        display: grid;
        grid-template-rows: 1fr;
        transition: grid-template-rows 0.26s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .crono-desglose-epo-body-inner { overflow: hidden; min-height: 0; }
    .crono-desglose-colapsado .crono-desglose-epo-body { grid-template-rows: 0fr; }

    @@media (prefers-reduced-motion: reduce) {
        .crono-desglose-epo-body,
        .crono-desglose-chevron { transition: none; }
    }
    .crono-desglose-epo-table { width: 100%; border-collapse: collapse; }
    .crono-desglose-epo-table thead th {
        background: #f1f5f9;
        color: #475569;
        font-size: 0.63rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        padding: 0.28rem 1rem;
        text-align: left;
        border-bottom: 1px solid #e2e8f0;
        position: static;
        top: auto;
        z-index: 1;
    }
    .crono-desglose-epo-table thead th:not(:first-child) { text-align: right; }
    .crono-desglose-epo-table tbody td {
        padding: 0.32rem 1rem;
        border-bottom: 1px solid #f1f5f9;
        color: #1e293b;
        font-size: 0.8rem;
    }
    .crono-desglose-epo-table tbody tr:last-child td { border-bottom: none; }
    .crono-desglose-epo-table tbody tr:hover td { background: #f0f9ff; }
    .crono-desglose-epo-dosis { font-weight: 700; color: #7c3aed; }
    .crono-desglose-epo-num   { text-align: right; }
    .crono-desglose-epo-costo { text-align: right; font-weight: 700; color: #0ea5e9; }
    .crono-desglose-epo-table tfoot td {
        background: var(--dm-brand-surface);
        color: #e2e8f0;
        font-weight: 700;
        font-size: 0.78rem;
        padding: 0.32rem 1rem;
        border-top: 2px solid #334155;
    }
    .crono-desglose-epo-total-label { color: var(--dm-on-brand-muted); font-size: 0.65rem; letter-spacing: 0.06em; }
    .crono-desglose-epo-total-val   { text-align: right; }
    .crono-desglose-epo-table tfoot .crono-desglose-epo-costo { color: #bfe9ff; }
    .crono-desglose-epo-sin-epo td  { color: #94a3b8; font-style: italic; border-top: 1px dashed #e2e8f0; }

    /* Panel EPO pendiente — naranja oscuro para diferenciarlo del administrado */
    .crono-desglose-pend { border-color: #fed7aa; }
    .crono-desglose-pend .crono-desglose-epo-header { background: #7c2d12; color: #fed7aa; }
    .crono-desglose-pend .crono-desglose-epo-header:hover  { background: #9a3412; }
    .crono-desglose-pend .crono-desglose-epo-header:active { background: #8a3110; }
    .crono-desglose-pend .crono-desglose-epo-header:focus-visible { outline-color: #fdba74; }
    .crono-desglose-pend .crono-desglose-epo-titulo { color: #ffedd5; }
    /* Antes #9a3412 sobre #7c2d12: contraste insuficiente para leer el subtítulo */
    .crono-desglose-pend .crono-desglose-epo-sub { color: #fdba74; }
    .crono-desglose-pend .crono-desglose-chevron { color: #fdba74; }
    .crono-desglose-pend .crono-peek-chip  { background: rgba(253, 186, 116, 0.18); color: #fed7aa; }
    .crono-desglose-pend .crono-peek-costo { background: rgba(249, 115, 22, 0.24); color: #ffedd5; }
    .crono-desglose-pend .crono-desglose-epo-table thead th { background: #fff7ed; }
    .crono-desglose-pend .crono-desglose-epo-table tfoot td { background: #7c2d12; border-top-color: #9a3412; }
    .crono-desglose-pend .crono-desglose-epo-table tfoot .crono-desglose-epo-costo { color: #fdba74; }
    .crono-desglose-pend-dosis { font-weight: 700; color: #f97316 !important; }
    .crono-pend-costo-val { color: #f97316 !important; }

    /* Empty state */
    .crono-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: #94a3b8;
        font-size: 0.9rem;
        border: 1px dashed #e2e8f0;
        border-radius: 12px;
    }
    .crono-empty p { margin: 0.25rem 0; }

    /* Scrollbar espejo — encima de la tabla para no tener que ir al pie */
    .crono-scroll-mirror {
        overflow-x: auto;
        overflow-y: hidden;
        height: 14px;
        border: 1px solid #e2e8f0;
        border-bottom: none;
        border-radius: 12px 12px 0 0;
        background: #f1f5f9;
        cursor: pointer;
    }
    .crono-scroll-mirror::-webkit-scrollbar        { height: 10px; }
    .crono-scroll-mirror::-webkit-scrollbar-thumb  { background: #94a3b8; border-radius: 5px; }
    .crono-scroll-mirror::-webkit-scrollbar-track  { background: #e2e8f0; border-radius: 5px; }
    #cronoScrollMirrorInner                        { height: 1px; }

    /* Table wrapper: scroll horizontal Y vertical para que position:sticky funcione */
    .crono-table-wrap {
        overflow: auto;
        max-height: calc(100svh - 480px);
        min-height: 320px;
        border-radius: 0 0 12px 12px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 1px 4px rgba(0,0,0,0.04);
    }

    /* Tabla */
    .crono-table {
        border-collapse: collapse;
        width: max-content;
        min-width: 100%;
        font-size: 0.78rem;
    }

    /* Cabecera sticky — fila 1 (título mes) en top:0; fila 2 (columnas) en top:44px */
    .crono-table thead th {
        position: sticky;
        top: 0;                     /* única fila de cabecera: se pega al tope */
        background: var(--dm-brand-surface);
        color: var(--dm-on-brand-soft);
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.55rem 0.5rem;
        text-align: center;
        z-index: 10;                /* por encima de celdas de body */
        white-space: nowrap;
    }

    /* Columnas fijas (sticky left) */
    .crono-th-fixed, .crono-td-fixed {
        position: sticky;
        left: 0;
        z-index: 6;                 /* body fixed > body scroll (auto) */
    }
    .crono-th-fixed { z-index: 15; background: var(--dm-brand-surface) !important; }
    /* (0,2,1) > (0,1,2): gana sobre .crono-table thead th — fija las columnas sobre las de fecha al desplazarse */
    .crono-table thead .crono-th-fixed { z-index: 25; }
    .crono-td-fixed { background: white; }

    /* Posiciones sticky: Paciente(0/180) · Cédula(180/80) · Sala(260/80) · Turno(340/90) · EPO(430/70) · Fe(500/70) */
    .crono-th-paciente, .crono-td-paciente { min-width: 180px; left: 0; text-align: left !important; }
    .crono-th-cedula,   .crono-td-cedula   { min-width: 80px;  left: 180px; text-align: center; font-size: 0.75rem; color: #64748b; }
    .crono-th-sala,     .crono-td-sala     { min-width: 80px;  left: 260px; text-align: center; }
    .crono-th-turno,    .crono-td-turno    { min-width: 90px;  left: 340px; }
    .crono-th-dosis,    .crono-td-dosis    { min-width: 70px; }
    .crono-th-epo,      .crono-td-epo      { left: 430px; }
    .crono-th-fe,       .crono-td-fe       { left: 500px; }
    .crono-th-pendiente, .crono-td-pendiente { min-width: 86px; left: 570px; text-align: center; }

    /* Badge dosis inicial pendiente — naranja */
    .crono-badge-pendiente {
        display: inline-block;
        background: #f97316;
        color: #fff;
        font-size: 0.72rem;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 10px;
        letter-spacing: 0.02em;
        white-space: nowrap;
    }

    /* Badge pendiente cuando ya fue aplicada — verde */
    .crono-badge-pendiente-aplicada { background: #16a34a; }

    /* Fecha sugerida de compensación */
    .crono-pend-fecha {
        font-size: 0.65rem;
        color: #64748b;
        margin-top: 2px;
        line-height: 1;
    }

    /* Botón "Aplicar" / "✓ Aplicada" */
    .crono-btn-marcar-aplicada {
        display: block;
        margin-top: 3px;
        padding: 1px 6px;
        font-size: 0.62rem;
        font-weight: 600;
        border: 1px solid #f97316;
        border-radius: 8px;
        background: transparent;
        color: #f97316;
        cursor: pointer;
        white-space: nowrap;
        transition: background 0.15s, color 0.15s;
    }
    .crono-btn-marcar-aplicada:hover { background: #f97316; color: #fff; }
    .crono-btn-ma-on {
        background: #16a34a;
        border-color: #16a34a;
        color: #fff;
    }
    .crono-btn-ma-on:hover { background: #15803d; border-color: #15803d; }

    /* Celdas de datos — guías de tabla más visibles */
    .crono-table tbody tr { border-bottom: 1px solid #e2e8f0; }
    .crono-table tbody tr:nth-child(even) td { background: #f8fafc; }
    .crono-table tbody tr:nth-child(even) .crono-td-fixed { background: #f8fafc; }
    .crono-table tbody tr:hover td { background: #e0f2fe !important; }
    .crono-table tbody tr:hover .crono-td-fixed { background: #e0f2fe !important; }

    .crono-td-sesion {
        padding: 0.25rem;
        text-align: center;
        min-width: 62px;
        border-left: 1px solid #e2e8f0;
        vertical-align: middle;
    }
    /* Celdas sin sesión: fondo gris claro */
    .crono-td-vacio { background: #f1f5f9; }
    /* Celdas CON sesión: fondo blanco con borde izquierdo azul para destacar */
    .crono-td-activo {
        background: white !important;
        border-left: 2px solid #bae6fd !important;
        cursor: pointer;
    }
    .crono-td-activo:hover { background: #dbeafe !important; }
    /* Edición manual: ámbar */
    .crono-td-manual { background: #fffbeb !important; border-left: 2px solid #fcd34d !important; }

    .crono-td-total {
        min-width: 85px;
        text-align: center;
        border-left: 3px solid var(--dm-brand-surface);
        padding: 0.3rem 0.4rem;
        vertical-align: middle;
    }
    .crono-td-total-epo  { background: #f0fdf4 !important; }
    .crono-td-total-fe   { background: #ecfdf5 !important; }

    .crono-total-num {
        font-size: 0.82rem;
        font-weight: 800;
        color: #166534;
        line-height: 1.1;
    }
    .crono-td-total-fe .crono-total-num { color: #0f766e; }

    .crono-total-costo {
        font-size: 0.68rem;
        font-weight: 600;
        color: #15803d;
        margin-top: 1px;
        background: #dcfce7;
        border-radius: 3px;
        padding: 0 3px;
        display: inline-block;
    }
    .crono-td-total-fe .crono-total-costo {
        color: #0d9488;
        background: #ccfbf1;
    }

    /* Fechas en encabezado */
    .crono-th-fecha { min-width: 62px; }
    .crono-fecha-dia { font-size: 0.58rem; color: var(--dm-on-brand-muted); }
    .crono-fecha-num { font-size: 0.85rem; color: var(--dm-on-brand); font-weight: 700; }

    /* Fin de semana: no hay sesión. Se apaga con un tono más profundo de la
       marca, no aclarando el fondo: al aclararlo, el número —que es blanco—
       quedaba invisible y la columna entera se leía como un hueco. */
    .crono-th-fecha.crono-fds { background: var(--dm-brand-surface-strong) !important; }
    .crono-th-fecha.crono-fds .crono-fecha-dia,
    .crono-th-fecha.crono-fds .crono-fecha-num { color: var(--dm-on-brand-soft); }

    /* Columna HOY — header */
    .crono-hoy-th {
        background: #0284c7 !important;
        color: white !important;
        box-shadow: 0 0 0 2px #7dd3fc inset;
    }
    .crono-hoy-th .crono-fecha-dia { color: #bae6fd; }
    .crono-hoy-th .crono-fecha-num { color: white; font-size: 1rem; }

    /* Columna HOY — celdas */
    .crono-hoy-celda {
        background: #f0f9ff !important;
        border-left: 1px solid #7dd3fc !important;
        border-right: 1px solid #7dd3fc !important;
    }
    .crono-td-activo.crono-hoy-celda { background: #e0f2fe !important; }

    /* Separador de semana */
    .crono-semana-inicio {
        border-left: 3px solid #475569 !important;
