@code {
    [Parameter] public EventCallback OnNavClick { get; set; }

    private async Task HandleClick() => await OnNavClick.InvokeAsync();

    // Permisos efectivos del usuario dentro de su tenant. Se resuelven una vez
    // por sesión de circuito: el menú se redibuja en cada navegación y consultar
    // la base en cada render sería un costo innecesario (el servicio cachea igual).
    private HashSet<string> _permisos = new(StringComparer.OrdinalIgnoreCase);
    private bool _permisosCargados;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var user = auth.User;

        if (user.Identity is not { IsAuthenticated: true })
        {
            _permisosCargados = true;
            return;
        }

        var roles = user.FindAll(ClaimTypes.Role).Select(c => c.Value).ToList();

        // El proveedor del sistema ve todo el menú aunque el tenant haya
        // recortado su matriz: necesita entrar para dar soporte.
        if (roles.Any(r => string.Equals(r, "SUPERADMIN", StringComparison.OrdinalIgnoreCase)))
        {
            _esSuperadmin = true;
            _permisosCargados = true;
            return;
        }

        if (Guid.TryParse(user.FindFirst("tenant_id")?.Value, out var tenantId) && tenantId != Guid.Empty)
        {
            try
            {
                _permisos = await PermisoService.GetPermisosEfectivosAsync(tenantId, roles);
            }
            catch
            {
                // Sin permisos resueltos el menú queda vacío, pero la aplicación
                // sigue navegable: cada página valida por su cuenta.
            }
        }

        _permisosCargados = true;
    }

    private bool _esSuperadmin;

    /// <summary>¿Se muestra esta opción del menú?</summary>
    private bool Puede(string codigo) =>
        _esSuperadmin || (_permisosCargados && _permisos.Contains(codigo));

    /// <summary>¿Hay alguna opción visible en el grupo? Evita títulos de sección huérfanos.</summary>
    private bool AlgunPermiso(params string[] codigos) => codigos.Any(Puede);
}

